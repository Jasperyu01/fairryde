EVALUATE
VAR FirstExport = MIN ( 'Excel_ZMMRP Monthend GR (SQL Sourced)'[ZMMRP Snapshot] )
VAR ReceiptKeys =
    CALCULATETABLE (
        DISTINCT ( 'SQL_Receipts Profit Centre'[PO_Mtrl_Date] ),
        'SQL_Receipts Profit Centre'[POSTING_DATE] > FirstExport
    )
RETURN
    ROW (
        "Earliest export used", FirstExport,
        "Latest receipt date", MAX ( 'SQL_Receipts Profit Centre'[POSTING_DATE] ),
        "Receipts after that export", COUNTROWS ( ReceiptKeys ),
        "Rows in GR table", COUNTROWS ( 'Excel_ZMMRP Monthend GR (SQL Sourced)' )
    )
