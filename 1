Screens:
  Mass Upload:
    Properties:
      Fill: =RGBA(234, 234, 234, 1)
      LoadingSpinnerColor: =RGBA(164, 38, 44, 1)
    Children:
      - Component1_2:
          Control: CanvasComponent
          ComponentName: Component1
          Properties:
            Height: =100
            Width: =1366
      - Icon3_11:
          Control: Classic/Icon@2.5.0
          Properties:
            BorderColor: =RGBA(89, 0, 0, 1)
            Color: =RGBA(251, 251, 251, 1)
            Height: =100
            Icon: =Icon.Home
            OnSelect: =Navigate(PriceChangeRequest, ScreenTransition.Fade)
            Width: =110
            X: =1256
      - TextInput:
          Control: Classic/TextInput@2.3.2
          Properties:
            BorderColor: =RGBA(89, 0, 0, 1)
            Default: =
            Font: =Font.'Open Sans'
            Height: =401
            HintText: ="Paste Excel Data here"
            HoverBorderColor: =RGBA(89, 0, 0, 1)
            HoverFill: =RGBA(222, 179, 184, 1)
            Mode: =TextMode.MultiLine
            Width: =627
            X: =34
            Y: =296
      - Button8_1:
          Control: Classic/Button@2.2.0
          Properties:
            BorderColor: =ColorFade(Self.Fill, -15%)
            Color: =RGBA(255, 255, 255, 1)
            DisabledBorderColor: =RGBA(166, 166, 166, 1)
            Fill: =RGBA(164, 38, 44, 1)
            Font: =Font.'Open Sans'
            Height: =60
            HoverBorderColor: =ColorFade(Self.BorderColor, 20%)
            HoverColor: =RGBA(255, 255, 255, 1)
            HoverFill: =ColorFade(RGBA(164, 38, 44, 1), -20%)
            OnSelect: |-
              =// ============================================================
              // PCR Mass Upload - Submit button OnSelect (fixed)
              // Changes vs original:
              //   1. StrategicVar / CMGroupKeyVar are cleaned (Trim + Char(160) -> space)
              //      before being used in the GroupKeyLookup Filter, and the cleaned value
              //      is what gets written to SharePoint.
              //   2. Concat separator changed from ", " to "; " (assignedTo needs semicolons).
              //   3. New STEP 0: resolve emails first and block submission with a clear
              //      message if any row cannot be matched, instead of silently sending "".
              //   4. rCMGroupKey / rIsTigerOrBlank now use the cleaned CM key.
              //   5. (2026-10) STEP 0 blocks rows whose PN + Vendor Code is already Pending Manager Approval.
              //   6. (2026-10) Annual quantity is written to the AnnualQuantity column; ApprovalEmailNoTariffNoCM reads it from there.
              //   7. (2026-10) All four approval flows get the USD prices in the FirstOld/FirstNew slots (13-14) and the stated
              //      prices in the Old/New slots (19-20, or 16-17 without tariff), the same order as Single Entry (they were swapped).
              //   8. (2026-10) STEP 0 blocks rows whose Annual Quantity is blank or 0 (a blank cell is parsed as 0, which makes the
              //      annual impact 0 and would skip the manager approval check). Same rule as the Single Entry price page.
              // ============================================================

              If(
                  varDisableWrite,
                  Notify(
                      "Cannot submit: Some rows have a CM Group Key but missing Email Link / justification.",
                      NotificationType.Error
                  ),
                  If(
                      CountRows(colTempData) = 0,
                      Notify(
                          "No parsed rows found. Paste + Parse first.",
                          NotificationType.Error
                      );
                      false,
                      If(
                          CountRows(colTempData) > 100,
                          Notify(
                              "Please upload max 100 rows per cycle.",
                              NotificationType.Error
                          );
                          false,

                          // ===== STEP 0: CLEAN + RESOLVE EMAILS, THEN VALIDATE =====
                          ClearCollect(
                              colLookupCheck,
                              ForAll(
                                  colTempData As r,
                                  With(
                                      {
                                          sName: Trim(Substitute(r.StrategicVar, Char(160), " ")),
                                          cName: Trim(Substitute(r.CMGroupKeyVar, Char(160), " "))
                                      },
                                      {
                                          RowPN: r.PNVar,
                                          StratName: sName,
                                          CMName: cName,
                                          StratEmails: Concat(
                                              Filter(GroupKeyLookup, Title = sName),
                                              Email, "; "
                                          ),
                                          CMEmails: Concat(
                                              Filter(GroupKeyLookup, Title = cName),
                                              Email, "; "
                                          ),
                                          IsTigerOrBlank: (cName = "" || IsBlank(cName) || Upper(cName) = "TIGER"),
                                          PendingMgr: !IsBlank(
                                              LookUp(
                                                  'Price Change',
                                                  PN = r.PNVar && 'Vendor Code' = r.VendorCodeVar &&
                                                  'Request Status' = "Pending Manager Approval"
                                              )
                                          ),
                                          NoQty: Coalesce(r.AnnualQuantityVar, 0) <= 0
                                      }
                                  )
                              )
                          );

                          If(
                              CountRows(
                                  Filter(
                                      colLookupCheck,
                                      PendingMgr || NoQty || IsBlank(StratEmails) || (!IsTigerOrBlank && IsBlank(CMEmails))
                                  )
                              ) > 0,
                              Notify(
                                  "Cannot submit -> " &
                                  Concat(
                                      FirstN(
                                          Filter(
                                              colLookupCheck,
                                              PendingMgr || NoQty || IsBlank(StratEmails) || (!IsTigerOrBlank && IsBlank(CMEmails))
                                          ),
                                          5
                                      ),
                                      RowPN & " [" & If(PendingMgr, "Pending Manager Approval", NoQty, "Annual Quantity is blank or 0", IsBlank(StratEmails), "no GroupKeyLookup email: " & StratName, "no GroupKeyLookup email: " & CMName) & "]",
                                      "  |  "
                                  ),
                                  NotificationType.Error
                              );
                              false,

                              // ===== STEP 1: PATCH ONLY =====
                              ClearCollect(
                                  colSubmitResults,
                                  ForAll(
                                      colTempData,
                                      With(
                                          {
                                              existingPNVendor: Filter(
                                                  'Price Change',
                                                  PN = PNVar && 'Vendor Code' = VendorCodeVar && ('Request Status' in ["Pending Approval / Feedback"] || IsBlank('Request Status'))
                                              ),
                                              StrategicClean: Trim(Substitute(StrategicVar, Char(160), " ")),
                                              CMKeyClean: Trim(Substitute(CMGroupKeyVar, Char(160), " "))
                                          },
                                          With(
                                              {
                                                  existingSP: LookUp(existingPNVendor, true),
                                                  CMEmail: Concat(
                                                      Filter(GroupKeyLookup, Title = CMKeyClean),
                                                      Email, "; "
                                                  ),
                                                  StratTeamEmail: Concat(
                                                      Filter(GroupKeyLookup, Title = StrategicClean),
                                                      Email, "; "
                                                  ),
                                                  TariffSelectedRow: ("Y" in Upper(Trim(ReasonTariff))),
                                                  ReasonValueRow: Concat(
                                                      Filter(
                                                          Table(
                                                              { k: "Tariff", v: ReasonTariff },
                                                              { k: "Labour Cost Inflation", v: ReasonLabour },
                                                              { k: "Raw Material Inflation", v: ReasonRawMaterial },
                                                              { k: "ECTS", v: ReasonECTS },
                                                              { k: "Price Decrease", v: ReasonPriceDecrease },
                                                              { k: "Add More Scale Qty", v: ReasonAddQty },
                                                              { k: "Others", v: ReasonOthers }
                                                          ),
                                                          ("Y" in Upper(Trim(v)))
                                                      ),
                                                      k, ", "
                                                  )
                                              },
                                              With(
                                                  {
                                                      patched: If(
                                                          !IsBlank(existingSP),
                                                          Patch(
                                                              'Price Change',
                                                              existingSP,
                                                              {
                                                                  Date: Today(),
                                                                  PN: PNVar,
                                                                  Description: DescriptionVar,
                                                                  'Vendor Code': VendorCodeVar,
                                                                  'Vendor Name': VendorNameVar,
                                                                  'PO Number': PONumberVar,
                                                                  'Requestor Name': RequestorVar,
                                                                  Remarks: RemarksVar,
                                                                  Currency: CurrencyVar,
                                                                  'Request Status': StatusVar,
                                                                  'Strategic Sourcing Personnel': StrategicClean,
                                                                  Approver: CMKeyClean,
                                                                  'Price Change Reason - Tariff': ReasonTariff,
                                                                  'Price Change Reason - Labour Cost Inflation': ReasonLabour,
                                                                  'Price Change Reason - Raw Material Inflation': ReasonRawMaterial,
                                                                  'Price Change Reason - ECTS': ReasonECTS,
                                                                  'Price Change Reason - Price Decrease': ReasonPriceDecrease,
                                                                  'Price Change Reason - Add More Scale Qty': ReasonAddQty,
                                                                  'Price Change Reason - Others': ReasonOthers
                                                              }
                                                          ),
                                                          Patch(
                                                              'Price Change',
                                                              Defaults('Price Change'),
                                                              {
                                                                  Title: "PC-" & Text(
                                                                      Coalesce(
                                                                          Max(
                                                                              'Price Change',
                                                                              Value(Mid(Title, 4, Len(Title) - 3))
                                                                          ),
                                                                          0
                                                                      ) + 1,
                                                                      "0000000"
                                                                  ),
                                                                  Date: Today(),
                                                                  PN: PNVar,
                                                                  Description: DescriptionVar,
                                                                  'Vendor Code': VendorCodeVar,
                                                                  'Vendor Name': VendorNameVar,
                                                                  'PO Number': PONumberVar,
                                                                  'Requestor Name': RequestorVar,
                                                                  Remarks: RemarksVar,
                                                                  Currency: CurrencyVar,
                                                                  'Request Status': StatusVar,
                                                                  'Strategic Sourcing Personnel': StrategicClean,
                                                                  Approver: CMKeyClean,
                                                                  'Price Change Reason - Tariff': ReasonTariff,
                                                                  'Price Change Reason - Labour Cost Inflation': ReasonLabour,
                                                                  'Price Change Reason - Raw Material Inflation': ReasonRawMaterial,
                                                                  'Price Change Reason - ECTS': ReasonECTS,
                                                                  'Price Change Reason - Price Decrease': ReasonPriceDecrease,
                                                                  'Price Change Reason - Add More Scale Qty': ReasonAddQty,
                                                                  'Price Change Reason - Others': ReasonOthers
                                                              }
                                                          )
                                                      )
                                                  },
                                                  With(
                                                      {
                                                          patched2: Patch(
                                                              'Price Change',
                                                              patched,
                                                              {
                                                                  'Old Price in Stated Currency': OldPriceVar,
                                                                  'Old Price in USD': OldPriceUSDVar,
                                                                  'New Price in Stated Currency': NewPriceVar,
                                                                  'New Price in USD': NewPriceUSDVar,
                                                                  'Price Delta': PriceDeltaVar,
                                                                  'Scale Quantity': ScaleQuantityVar,
                                                                  'Tariff Percentage': TariffPercentageVar,
                                                                  'Tariff Value (USD)': TariffValueUSDVar,
                                                                  'Estimated Tariff Annual Impact (USD)': EstimatedAnnualTariffImpactVar,
                                                                  'Estimated Delta Annual Impact (USD)': AnnualPriceDeltaImpactVar,
                                                                  AnnualQuantity: Coalesce(If(AnnualQuantityVar = Int(AnnualQuantityVar), Text(AnnualQuantityVar, "[$-en-US]#,##0"), Text(AnnualQuantityVar, "[$-en-US]#,##0.##")), "N/A"),
                                                                  'Email Link': EmailLinkVar
                                                              }
                                                          )
                                                      },
                                                      {
                                                          rPN: PNVar,
                                                          rVendorCode: VendorCodeVar,
                                                          rTPCID: patched2.Title,
                                                          rSharePointID: patched2.ID,
                                                          rStatus: StatusVar,
                                                          rTariffSelected: TariffSelectedRow,
                                                          rCMGroupKey: CMKeyClean,
                                                          rIsTigerOrBlank: (CMKeyClean = "" || IsBlank(CMKeyClean) || Upper(CMKeyClean) = "TIGER"),
                                                          rDescription: DescriptionVar,
                                                          rVendorName: VendorNameVar,
                                                          rPONumber: PONumberVar,
                                                          rRequestor: RequestorVar,
                                                          rRequestorEmail: RequestorEmailVar,
                                                          rRemarks: RemarksVar,
                                                          rCurrency: CurrencyVar,
                                                          rOldPrice: OldPriceVar,
                                                          rNewPrice: NewPriceVar,
                                                          rOldPriceUSD: OldPriceUSDVar,
                                                          rNewPriceUSD: NewPriceUSDVar,
                                                          rScaleQty: ScaleQuantityVar,
                                                          rTariffPct: TariffPercentageVar,
                                                          rTariffValueUSD: TariffValueUSDVar,
                                                          rEstAnnualTariffImpact: EstimatedAnnualTariffImpactVar,
                                                          rAnnualDeltaImpact: AnnualPriceDeltaImpactVar,
                                                          rStratTeamEmail: StratTeamEmail,
                                                          rCMEmail: CMEmail,
                                                          rEmailLink: EmailLinkVar,
                                                          rReasonValue: ReasonValueRow
                                                      }
                                                  )
                                              )
                                          )
                                      )
                                  )
                              );

                              // ===== STEP 2: TRIGGER FLOWS SEPARATELY =====
                              ForAll(
                                  Filter(colSubmitResults, rStatus <> "Negotiation Successful"),
                                  If(
                                      ThisRecord.rTariffSelected,
                                      If(
                                          ThisRecord.rIsTigerOrBlank,
                                          ApprovalEmailTariffNoCM.Run(
                                              ThisRecord.rTPCID, ThisRecord.rPN, ThisRecord.rVendorCode, ThisRecord.rVendorName,
                                              ThisRecord.rPONumber, ThisRecord.rRequestor, ThisRecord.rRemarks,
                                              ThisRecord.rSharePointID, ThisRecord.rCMGroupKey, ThisRecord.rDescription,
                                              ThisRecord.rRequestorEmail, ThisRecord.rCurrency,
                                              ThisRecord.rOldPriceUSD, ThisRecord.rNewPriceUSD,   // 13-14: USD
                                              ThisRecord.rTariffPct, ThisRecord.rEstAnnualTariffImpact,
                                              ThisRecord.rScaleQty, ThisRecord.rTariffValueUSD,
                                              ThisRecord.rOldPrice, ThisRecord.rNewPrice,         // 19-20: stated currency
                                              ThisRecord.rStratTeamEmail, ThisRecord.rEmailLink, ThisRecord.rCMEmail,
                                              ThisRecord.rReasonValue, ThisRecord.rAnnualDeltaImpact
                                          ),
                                          ApprovalEmail.Run(
                                              ThisRecord.rTPCID, ThisRecord.rPN, ThisRecord.rVendorCode, ThisRecord.rVendorName,
                                              ThisRecord.rPONumber, ThisRecord.rRequestor, ThisRecord.rRemarks,
                                              ThisRecord.rSharePointID, ThisRecord.rCMGroupKey, ThisRecord.rDescription,
                                              ThisRecord.rRequestorEmail, ThisRecord.rCurrency,
                                              ThisRecord.rOldPriceUSD, ThisRecord.rNewPriceUSD,   // 13-14: USD
                                              ThisRecord.rTariffPct, ThisRecord.rEstAnnualTariffImpact,
                                              ThisRecord.rScaleQty, ThisRecord.rTariffValueUSD,
                                              ThisRecord.rOldPrice, ThisRecord.rNewPrice,         // 19-20: stated currency
                                              ThisRecord.rStratTeamEmail, ThisRecord.rEmailLink, ThisRecord.rCMEmail,
                                              ThisRecord.rReasonValue, ThisRecord.rAnnualDeltaImpact
                                          )
                                      ),
                                      If(
                                          ThisRecord.rIsTigerOrBlank,
                                          ApprovalEmailNoTariffNoCM.Run(
                                              ThisRecord.rTPCID, ThisRecord.rPN, ThisRecord.rVendorCode, ThisRecord.rVendorName,
                                              ThisRecord.rPONumber, ThisRecord.rRequestor, ThisRecord.rRemarks,
                                              ThisRecord.rSharePointID, ThisRecord.rCMGroupKey, ThisRecord.rDescription,
                                              ThisRecord.rRequestorEmail, ThisRecord.rCurrency,
                                              ThisRecord.rOldPriceUSD, ThisRecord.rNewPriceUSD,   // 13-14: USD
                                              ThisRecord.rScaleQty,
                                              ThisRecord.rOldPrice, ThisRecord.rNewPrice,         // 16-17: stated currency
                                              ThisRecord.rStratTeamEmail, ThisRecord.rEmailLink, ThisRecord.rCMEmail,
                                              ThisRecord.rReasonValue, ThisRecord.rAnnualDeltaImpact
                                          ),
                                          ApprovalEmailNoTariff.Run(
                                              ThisRecord.rTPCID, ThisRecord.rPN, ThisRecord.rVendorCode, ThisRecord.rVendorName,
                                              ThisRecord.rPONumber, ThisRecord.rRequestor, ThisRecord.rRemarks,
                                              ThisRecord.rSharePointID, ThisRecord.rCMGroupKey, ThisRecord.rDescription,
                                              ThisRecord.rRequestorEmail, ThisRecord.rCurrency,
                                              ThisRecord.rOldPriceUSD, ThisRecord.rNewPriceUSD,   // 13-14: USD
                                              ThisRecord.rScaleQty,
                                              ThisRecord.rOldPrice, ThisRecord.rNewPrice,         // 16-17: stated currency
                                              ThisRecord.rStratTeamEmail, ThisRecord.rEmailLink, ThisRecord.rCMEmail,
                                              ThisRecord.rReasonValue, ThisRecord.rAnnualDeltaImpact
                                          )
                                      )
                                  )
                              );

                              Notify(
                                  "Submitted " & Text(CountRows(colSubmitResults)) & " row(s).",
                                  NotificationType.Success
                              );
                              Refresh('Price Change')
                          )
                      )
                  )
              )
            PressedBorderColor: =Self.Fill
            PressedColor: =Self.Fill
            PressedFill: =Self.Color
            Text: ="Submit"
            Width: =178
            X: =322
            Y: =223
      - Button7_1:
          Control: Classic/Button@2.2.0
          Properties:
            BorderColor: =ColorFade(Self.Fill, -15%)
            Color: =RGBA(255, 255, 255, 1)
            DisabledBorderColor: =RGBA(166, 166, 166, 1)
            Fill: =RGBA(164, 38, 44, 1)
            Font: =Font.'Open Sans'
            FontWeight: =FontWeight.Bold
            Height: =60
            HoverBorderColor: =ColorFade(Self.BorderColor, 20%)
            HoverColor: =RGBA(255, 255, 255, 1)
            HoverFill: =ColorFade(RGBA(164, 38, 44, 1), -20%)
            OnSelect: |-
              =// Step 1: Split pasted rows (Excel paste)
              ClearCollect(
                  colRawRows,
                  Filter(
                      Split(
                          TrimEnds(TextInput.Text),
                          Char(10)
                      ),
                      !IsBlank(Trim(ThisRecord.Value))
                  )
              );

              // Step 2: Convert each row into structured records (TAB-separated)
              ClearCollect(
                  colTempData,
                  ForAll(
                      colRawRows,
                      With(
                          {
                              // ===== PRE-CLEAN: NBSP -> space, strip CR, Trim =====
                              // 空格单元格在这里变成真正的空字符串，IsBlank 才会生效
                              cells: ForAll(
                                  Split(ThisRecord.Value, Char(9)) As c,
                                  {
                                      Value: Trim(
                                          Substitute(
                                              Substitute(c.Value, Char(160), " "),
                                              Char(13),
                                              ""
                                          )
                                      )
                                  }
                              )
                          },

                          With(
                              {
                                  _currency: If(CountRows(cells) >= 19, Last(FirstN(cells, 19)).Value, ""),

                                  _fxRate: Coalesce(
                                      LookUp(
                                          'FX_PRate',
                                          'Currency' = If(CountRows(cells) >= 19, Last(FirstN(cells, 19)).Value, "")
                                      ).'Current Year Currency',
                                      0
                                  ),

                                  _minScaleQty: If(
                                      CountRows(cells) >= 20 && !IsBlank(Last(FirstN(cells, 20)).Value),
                                      IfError(Value(Substitute(Last(FirstN(cells, 20)).Value, ",", "")), 0),
                                      0
                                  ),

                                  _oldStated: If(
                                      CountRows(cells) >= 21 && !IsBlank(Last(FirstN(cells, 21)).Value),
                                      IfError(Value(Substitute(Substitute(Last(FirstN(cells, 21)).Value, ",", ""), "$", "")), 0),
                                      0
                                  ),

                                  _newStated: If(
                                      CountRows(cells) >= 22 && !IsBlank(Last(FirstN(cells, 22)).Value),
                                      IfError(Value(Substitute(Substitute(Last(FirstN(cells, 22)).Value, ",", ""), "$", "")), 0),
                                      0
                                  ),

                                  _annualQty: If(
                                      CountRows(cells) >= 23 && !IsBlank(Last(FirstN(cells, 23)).Value),
                                      IfError(Value(Substitute(Last(FirstN(cells, 23)).Value, ",", "")), 0),
                                      0
                                  ),

                                  _tariffStated: If(
                                      CountRows(cells) >= 24 && !IsBlank(Last(FirstN(cells, 24)).Value),
                                      IfError(Value(Substitute(Substitute(Last(FirstN(cells, 24)).Value, ",", ""), "$", "")), 0),
                                      0
                                  )
                              },

                              With(
                                  {
                                      _oldUSD: If(_fxRate <> 0, _oldStated / _fxRate, 0),
                                      _newUSD: If(_fxRate <> 0, _newStated / _fxRate, 0),
                                      _tariffUSD: If(_fxRate <> 0, _tariffStated / _fxRate, 0),

                                      _deltaStated: _newStated - _oldStated,
                                      _deltaUSD: If(_fxRate <> 0, (_newStated - _oldStated) / _fxRate, 0),

                                      _tariffPct: If(
                                          _fxRate <> 0 && Abs((_newStated - _oldStated) / _fxRate) > 0,
                                          (_tariffStated / _fxRate) / ((_newStated - _oldStated) / _fxRate) * 100,
                                          0
                                      ),

                                      _annualDeltaImpactUSD: If(_fxRate <> 0, (_newStated - _oldStated) * _annualQty / _fxRate, 0),
                                      _annualTariffImpactUSD: If(_fxRate <> 0, _tariffStated * _annualQty / _fxRate, 0)
                                  },

                                  {
                                      PNVar           : If(CountRows(cells) >= 1, Last(FirstN(cells, 1)).Value, ""),
                                      DescriptionVar  : If(CountRows(cells) >= 2, Last(FirstN(cells, 2)).Value, ""),
                                      VendorCodeVar   : If(CountRows(cells) >= 3, Last(FirstN(cells, 3)).Value, ""),
                                      VendorNameVar   : If(CountRows(cells) >= 4, Last(FirstN(cells, 4)).Value, ""),
                                      PONumberVar     : If(CountRows(cells) >= 5, Last(FirstN(cells, 5)).Value, ""),
                                      StatusVar       : If(CountRows(cells) >= 6, Last(FirstN(cells, 6)).Value, ""),
                                      RequestorVar      : If(CountRows(cells) >= 7, Last(FirstN(cells, 7)).Value, ""),
                                      RequestorEmailVar : If(CountRows(cells) >= 8, Last(FirstN(cells, 8)).Value, ""),
                                      CMGroupKeyVar   : If(CountRows(cells) >= 9,  Last(FirstN(cells, 9)).Value, ""),
                                      StrategicVar    : If(CountRows(cells) >= 10, Last(FirstN(cells,10)).Value, ""),

                                      ReasonTariff:
                                          If(CountRows(cells) >= 11 && ("Y" in Upper(Last(FirstN(cells, 11)).Value)), "Yes", "No"),
                                      ReasonLabour:
                                          If(CountRows(cells) >= 12 && ("Y" in Upper(Last(FirstN(cells, 12)).Value)), "Yes", "No"),
                                      ReasonRawMaterial:
                                          If(CountRows(cells) >= 13 && ("Y" in Upper(Last(FirstN(cells, 13)).Value)), "Yes", "No"),
                                      ReasonECTS:
                                          If(CountRows(cells) >= 14 && ("Y" in Upper(Last(FirstN(cells, 14)).Value)), "Yes", "No"),
                                      ReasonPriceDecrease:
                                          If(CountRows(cells) >= 15 && ("Y" in Upper(Last(FirstN(cells, 15)).Value)), "Yes", "No"),
                                      ReasonAddQty:
                                          If(CountRows(cells) >= 16 && ("Y" in Upper(Last(FirstN(cells, 16)).Value)), "Yes", "No"),
                                      ReasonOthers:
                                          If(CountRows(cells) >= 17 && ("Y" in Upper(Last(FirstN(cells, 17)).Value)), "Yes", "No"),

                                      RemarksVar: If(CountRows(cells) >= 18, Last(FirstN(cells, 18)).Value, ""),
                                      CurrencyVar: _currency,
                                      FxRateVar  : _fxRate,
                                      ScaleQuantityVar: _minScaleQty,
                                      OldPriceVar          : _oldStated,
                                      NewPriceVar          : _newStated,
                                      AnnualQuantityVar    : _annualQty,
                                      TariffValueStatedVar : _tariffStated,
                                      OldPriceUSDVar                 : Round(_oldUSD, 2),
                                      NewPriceUSDVar                 : Round(_newUSD, 2),
                                      TariffValueUSDVar              : Round(_tariffUSD, 2),
                                      EstimatedAnnualTariffImpactVar : Round(_annualTariffImpactUSD, 2),
                                      PriceDeltaVar              : Text(Round(_deltaStated, 2), "[$-en-US]#,##0.00"),
                                      TariffPercentageVar        : Text(Round(_tariffPct, 2), "[$-en-US]#,##0.00"),
                                      AnnualPriceDeltaImpactVar  : Text(Round(_annualDeltaImpactUSD, 2), "[$-en-US]#,##0.00"),
                                      EmailLinkVar: If(CountRows(cells) >= 25, Last(FirstN(cells, 25)).Value, "")
                                  }
                              )
                          )
                      )
                  )
              );

              // Find rows with invalid email link
              ClearCollect(
                  colInvalidEmailLinks,
                  Filter(
                      colTempData,
                      !IsBlank(CMGroupKeyVar) && IsBlank(EmailLinkVar)
                  )
              );

              Set(varDisableWrite, CountRows(colInvalidEmailLinks) > 0);

              If(
                  varDisableWrite,
                  Notify(
                      "Error: " & Text(CountRows(colInvalidEmailLinks)) &
                      " row(s) have a CM Group Key but missing Email Link / justification. Please fill it in before submitting.",
                      NotificationType.Error
                  ),
                  Notify(
                      "Parsed " & Text(CountRows(colTempData)) & " row(s).",
                      NotificationType.Success
                  )
              );
            PressedBorderColor: =Self.Fill
            PressedColor: =Self.Fill
            PressedFill: =Self.Color
            Text: ="Parse Data"
            Width: =179
            X: =34
            Y: =223
      - Gallery1:
          Control: Gallery@2.15.0
          Variant: BrowseLayout_Vertical_TwoTextOneImageVariant_ver5.0
          Properties:
            BorderColor: =RGBA(89, 0, 0, 1)
            Height: =402
            Items: =colTempData
            TemplateSize: =87
            Width: =590
            X: =697
            Y: =296
          Children:
            - Title1:
                Control: Label@2.5.1
                Properties:
                  BorderColor: =RGBA(0, 0, 0, 1)
                  Color: =RGBA(50, 49, 48, 1)
                  Font: =Font.'Open Sans'
                  FontWeight: =If(ThisItem.IsSelected, FontWeight.Semibold, FontWeight.Normal)
                  Height: =Self.Size * 1.8
                  OnSelect: =Select(Parent)
                  PaddingBottom: =0
                  PaddingLeft: =0
                  PaddingRight: =0
                  PaddingTop: =0
                  Size: =14
