-- ① 列名和类型
SELECT ORDINAL_POSITION AS POS, COLUMN_NAME, DATA_TYPE
FROM DUN02_HESDATAMART01.INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_NAME = 'PLNT_MTRL_SRC'
ORDER BY ORDINAL_POSITION;

-- ② 2750 的 20 行样本
SELECT TOP 20 * FROM DUN02_HESDATAMART01.dbo.PLNT_MTRL_SRC WITH (NOLOCK)
WHERE PLNT_CD = '2750';

-- ③ 2750 有多少行，最新创建到哪天
SELECT COUNT(*) AS rows_2750, MAX(CREAT_DT) AS last_created
FROM DUN02_HESDATAMART01.dbo.PLNT_MTRL_SRC WITH (NOLOCK)
WHERE PLNT_CD = '2750';

-- ④ Excel supplier tab 里那 11 个 PN
SELECT * FROM DUN02_HESDATAMART01.dbo.PLNT_MTRL_SRC WITH (NOLOCK)
WHERE PLNT_CD = '2750'
  AND SUBSTRING(MTRL_NBR, PATINDEX('%[^0]%', MTRL_NBR + '.'), 40) IN
      ('102813162','101404960','101006006','102469034','100141408','101653023',
       '101719203','101608658','101893759','101533843','120167218');
