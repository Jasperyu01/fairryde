SELECT CAST(RUN_DT AS date) AS run_date,
       COUNT(*) AS all_rows,
       SUM(CASE WHEN MRP_ELEM_NBR LIKE '%454_______' THEN 1 ELSE 0 END) AS s4_po_rows
FROM [DUN02_HESDATAMART01].[dbo].[PLNT_MTRL_DLY_REQ] WITH (NOLOCK)
WHERE MRP_ELEM_CD IN ('BE', 'LA')
GROUP BY CAST(RUN_DT AS date)
ORDER BY run_date DESC;
