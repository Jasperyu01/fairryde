-- 1. 同一个 schema 下还有哪些表和视图
SELECT TABLE_NAME, TABLE_TYPE
FROM PowerBI.INFORMATION_SCHEMA.TABLES
WHERE TABLE_SCHEMA = 'CAR01_CPS_DATA'
ORDER BY TABLE_NAME;

-- 2. 整个库里哪些对象带条件记录号这一列
SELECT TABLE_SCHEMA, TABLE_NAME, COLUMN_NAME
FROM PowerBI.INFORMATION_SCHEMA.COLUMNS
WHERE COLUMN_NAME LIKE '%CONDITION_NUM%'
   OR COLUMN_NAME LIKE '%KNUMH%'
ORDER BY TABLE_SCHEMA, TABLE_NAME;
