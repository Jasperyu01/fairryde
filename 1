        {"POSTING_DATE", type date}, {"POSTING_YEAR", type number}, {"POSTING_PERIOD", type number},
        {"PURCHASE_ORDER", type text}, {"PURCHASE_ORDER_ITEM", type number}, {"MATERIAL", type text},
        {"VENDOR_ACCT_NBR", type text}, {"PROFIT_CENTER", type text}, {"ACCOUNT_NUM", type text},
        {"COMPANY_CODE", type text}, {"PLANT", type text}, {"LOCAL_CURRENCY_CD", type text},
        {"ITEM_TEXT", type text}, {"USER_ID", type text}, {"REF_DOCUMENT_NUM", type text}, {"MOVEMENT_TYPE", type text},
        {"QUANTITY", type number}, {"USD_CURRENCY_VALUE", type number}, {"LOCAL_CURRENCY_VALUE", type number},
        {"CALC_MATAPP", type number},
        // columns that only the SQL part fills: kept on the types they had before
        {"ACCT_DOC_NBR", type text}, {"ACCT_DOC_ITM", Int64.Type}, {"ACCT_ENTRY_DATE", type date},
        {"ACCT_ENTRY_DATE_TIME", type date}, {"VALUE_DATE", type date}, {"UPDTTM", type date},
        {"ORDER_NUMBER", type text}, {"ORDER_TYPE", type text}, {"SPECIAL_STOCK", type text},
        {"REF_DOCUMENT_ITEM", type number}, {"LI_DOC_TYPE", type text}, {"OBJECT_TYPE", type number}, {"ACTIVITY", type text}},
    ExistingColumns = Table.ColumnNames(WithDateKey),
    Result = Table.TransformColumnTypes(WithDateKey, List.Select(TypeMap, each List.Contains(ExistingColumns, _{0})), "en-US")
in
    Result
