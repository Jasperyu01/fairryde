    #"Merged Columns" = Table.CombineColumns(Table.TransformColumnTypes(#"Duplicated Column1", {{"PURCHASE_ORDER_ITEM - Copy", type text}}, "en-US"),{"PURCHASE_ORDER - Copy", "PURCHASE_ORDER_ITEM - Copy"},Combiner.CombineTextByDelimiter("_", QuoteStyle.None),"PO_Item"),
    #"Filtered Rows" = Table.SelectRows(#"Merged Columns", each ([PO_Item] <> "_0") and ([ACCOUNT_NUM] = "145000" or [ACCOUNT_NUM] = "145300")),
