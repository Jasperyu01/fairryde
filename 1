    // the header row is the first row that holds PART_NUMBER
    WithHeaders = if List.Contains(Table.ColumnNames(Raw), "PART_NUMBER") then Raw
        else Table.PromoteHeaders(
            Table.Skip(Raw, each not List.Contains(Record.ToList(_), "PART_NUMBER")),
            [PromoteAllScalars = true]),
    Kept = Table.SelectColumns(WithHeaders, Cols),
    NoEmptyText = Table.ReplaceValue(Kept, "", null, Replacer.ReplaceValue, Cols),
    NoBlankRows = Table.SelectRows(NoEmptyText, each [PART_NUMBER] <> null),
    Typed = Table.TransformColumnTypes(NoBlankRows, {
        {"VENDOR_CODE",                 type text},
        {"VENDOR_NAME",                 type text},
        {"PART_NUMBER",                 type text},
        {"PRICING_UNIT",                type number},
