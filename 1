-- A. 不碰 VAKEY，看视图主体能不能跑
SELECT TOP 5 VNDR_NBR, INFO_NBR, COND_RECD_NBR, KSTBM_SCALE_QNT, KBETR_COND_RATE
FROM [PowerBI].[DUN02_HESDATAMART01].[V_FOSO_PROCUREMENT] WITH (NOLOCK);

-- B. 只取 2750 工厂、按物料建的记录
SELECT TOP 20
    VNDR_NBR, [VENDOR NAME], INFO_NBR, COND_RECD_NBR,
    SUBSTRING(VAKEY_VAR_KEY, 11, 18) AS MATERIAL,
    PRC_UNIT, PO_PRC_UOM_CD, NET_PRC, CRNCY_CD,
    KSTBM_SCALE_QNT, KBETR_COND_RATE, DATBI_VLD_TO_DT
FROM [PowerBI].[DUN02_HESDATAMART01].[V_FOSO_PROCUREMENT] WITH (NOLOCK)
WHERE LEN(VAKEY_VAR_KEY) = 37
  AND SUBSTRING(VAKEY_VAR_KEY, 33, 4) = '2750';
