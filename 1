let
    Source = Sql.Database("scgreporting", "dun02_hesdatamart01", [Query = "
SELECT
    CASE WHEN pc.PRFT_CNTR_GRP LIKE '1SDS%' THEN 'SPERRY'
         WHEN pc.PRFT_CNTR_GRP LIKE '1WLP%' THEN 'WIRELINE'
         ELSE pc.PRFT_CNTR_GRP END AS [BU],
    pm.MTRL_NBR             AS [MTRL],
    m.MTRL_DSC              AS [Desc],
    m.MTRL_TYPE_CD          AS [Type],
    pm.PLNT_CD              AS [Plnt],
    m.BASE_UOM_CD           AS [UM],
    pm.PRCRMNT_TYPE_CD      AS [P/T],
    pm.MRP_CNTRLR_CD        AS [MRP],
    pm.BUYR_CD              AS [PGr],
    b.NM                    AS [PGr_Name],
    pm.PRFT_CNTR_CD         AS [ProfCtr],
    pm.PLN_DLVR_TM_DAYS     AS [PDT],
    pm.SFTY_STCK            AS [SftyStk],
    pm.LOT_SZ_CD            AS [LS],
    pm.MIN_LOT_SZ           AS [MinLot],
    pm.RND_VAL              AS [RndVal],
    pm.MTRL_STAT_CD         AS [MMPP]
FROM [DUN02_HESDATAMART01].[dbo].[PLNT_MTRL] pm WITH (NOLOCK)
LEFT JOIN [DUN02_HESDATAMART01].[dbo].[MTRL] m WITH (NOLOCK)
       ON m.OID = pm.MTRL_OID
LEFT JOIN [DUN02_HESDATAMART01].[dbo].[PRFT_CNTR] pc WITH (NOLOCK)
       ON pc.OID = pm.PRFT_CNTR_OID
OUTER APPLY (SELECT TOP 1 bb.NM
             FROM [DUN02_HESDATAMART01].[dbo].[BUYR] bb WITH (NOLOCK)
             WHERE bb.BUYR_CD = pm.BUYR_CD
             ORDER BY bb.UPDTMS DESC) b
WHERE pm.PLNT_CD IN ('2750', '2020')"]),
    Cleaned = Table.TransformColumns(Source, {
        {"MTRL", each if _ = null then null else Text.TrimStart(Text.Trim(_), "0"), type text},
        {"Desc", each if _ = null then null else Text.Trim(_), type text}}),
    Typed = Table.TransformColumnTypes(Cleaned, {
        {"Plnt", type text}, {"PDT", type number}, {"SftyStk", type number},
        {"MinLot", type number}, {"RndVal", type number}})
in
    Typed
