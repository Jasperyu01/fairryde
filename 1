// Write & collect Excel results
ClearCollect(
  SubmittedTrial,
  ForAll(
    colData,
    With(
      {
        // 1) Delegable: pull all rows for this PN
        existingXLPN: Filter(
          'Trial',
          PN = PNVar
        )
      },
      With(
        {
          // 2) Local: pick the first row whose status is New or In Progress
          existingXL: LookUp(
            existingXLPN,
            'Status of Completion' = "New"
              || 'Status of Completion' = "In Progress"
          )
        },
        If(
          !IsBlank(existingXL),
          // UPDATE existing Excel row
          Patch(
            'Trial',
            existingXL,
            {
              'Estimated Quantity':
                existingXL.'Estimated Quantity'
                + Value(QuantityVar),
              'Requestor Name'     :
                existingXL.'Requestor Name'
                & ", "
                & RequestorVar,
              Projects             :
                existingXL.Projects
                & ", "
                & ProjectVar,
              'Requestor Remarks'  :
                existingXL.'Requestor Remarks'
                & ", "
                & RemarksVar,
              'Action Owner'       : If(IsBlank(ActionVar), existingXL.'Action Owner', ActionVar),
              'Latest Request Date': DateVar
            }
          ),
          // CREATE new Excel row
          Patch(
            'Trial',
            Defaults('Trial'),
            {
              PN                    : PNVar,
              'Creation Date'       : DateVar,
              Description           : DescriptionVar,
              'Estimated Quantity'  : Value(QuantityVar),
              'Requestor Name'      : RequestorVar,
              Projects              : ProjectVar,
              Reason                : ReasonVar,
              'Status of Completion': "New",
              'Requestor Remarks'   : RemarksVar,
              'Need Date'           : DeadlineVar,
              'Action Owner'        : ActionVar,
              'Latest Request Date' : DateVar
            }
          )
        )
      )
    )
  )
);

// Collect submitted PNs
ClearCollect(
  colSubmittedPNs,
  ForAll(
    colData,
    { PN: PNVar }
  )
);

// Final toast & navigate
Notify(
  "Submission Successful",
  NotificationType.Success
);
Navigate(
  'Part Request Mass Upload Successful Submission',
  ScreenTransition.Fade
);
