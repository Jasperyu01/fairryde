Set(ApproverNameValue, If(GroupKeyOwner.Selected.Value = "", "Nil", GroupKeyOwner.Selected.Value));

With(
    { reasonValues: ComboBoxPriceReason.SelectedItems.Value },
    Set(TariffSelected, "Tariff" in reasonValues);
    Set(oneoffSelected, "One Time Approval" in reasonValues);

    If(
        Dropdown1.Selected.Value = "",
        Notify("Please select a value for Request Status", NotificationType.Error),

        If(
            !IsEmpty(
                Filter(
                    Filter('Price Change', PN = DataCardValue2.Text && 'Vendor Code' = DataCardValue4.Text),
                    ('Request Status' in [
                        "Pending Approval / Feedback",
                        "Pending Manager Approval",
                        "CM Requesting More Info",
                        "Sourcing Team Requesting More Info",
                        ""
                    ] || IsBlank('Request Status'))
                )
            ),

            Set(
                ActiveRowP,
                First(
                    Filter(
                        Filter('Price Change', PN = DataCardValue2.Text && 'Vendor Code' = DataCardValue4.Text),
                        ('Request Status' in [
                            "Pending Approval / Feedback",
                            "Pending Manager Approval",
                            "CM Requesting More Info",
                            "Sourcing Team Requesting More Info",
                            ""
                        ] || IsBlank('Request Status'))
                    )
                )
            );

            If(
                // 2026-10: while manager approval is pending, no resubmission (Cancelled / Negotiation Successful still allowed)
                (
                    ActiveRowP.'Request Status' = "Pending Manager Approval" &&
                    !(Dropdown1.Selected.Value in ["Cancelled", "Negotiation Successful"])
                ) ||
                (
                    !(IsBlank(ActiveRowP.Approver) && IsBlank(GroupKeyOwner.Selected.Value)) &&
                    ActiveRowP.Approver <> GroupKeyOwner.Selected.Value &&
                    ActiveRowP.'Request Status' = "Pending Approval / Feedback"
                ),

                Notify(
                    If(
                        ActiveRowP.'Request Status' = "Pending Manager Approval",
                        "This request is waiting for manager approval. You can only set it to Cancelled or Negotiation Successful.",
                        "You must wait for current Approver to return a response before submitting this edit!"
                    ),
                    NotificationType.Error
                ),

                Set(IsEditMode, true);
                Set(StatusValue, Dropdown1.Selected.Value);
                Set(SharepointID, ActiveRowP.ID);
                Set(TPCIDValue, ActiveRowP.Title);
                Set(PNValue, DataCardValue2.Text);
                Set(DescriptionValue, DataCardValue3.Text);
                Set(VendorCodeValue, DataCardValue4.Text);
                Set(VendorNameValue, DataCardValue5.Text);
                Set(PONumberValue, DataCardValue6.Text);
                Set(RequestorNameValue, User().FullName);
                Set(RequestorEmailValue, User().Email);
                Set(RemarksValue, ActiveRowP.Remarks & ", " & DataCardValue9.Text);
                Set(RequestorNameAppended, ActiveRowP.'Requestor Name' & ", " & User().FullName);
                Set(ApproverNameValue, If(GroupKeyOwner.Selected.Value = "", "Nil", GroupKeyOwner.Selected.Value));
                Set(CurrencyValue, Dropdown2.Selected.Value);
                Set(ReasonValue, Concat(ComboBoxPriceReason.SelectedItems, Value, ", "));
                Set(ReasonValues, reasonValues);
                Set(StratSourcingPersonnel, TextInput4.Text);
                Set(
                    ExchangeRate,
                    LookUp('Exchange Rate', Title = Dropdown2.Selected.Value).'USD 2025 (Currency/Rate)'
                );
                Set(StratTeamEmail,
                    Concat(Filter(GroupKeyLookup, Title = TextInput4.Text), Email, "; ")
                );
                Set(ApproverEmailValue,
                    Concat(Filter(GroupKeyLookup, Title = GroupKeyOwner.Selected.Value), Email, "; ")
                );

                If(
                    StatusValue = "Cancelled",
                    Patch('Price Change', ActiveRowP, { 'Request Status': "Cancelled" });
                    ResetForm(Form1);
                    Navigate(PriceChangeRequest_PNData, ScreenTransition.Fade),

                    ResetForm(Form1);
                    Navigate('PriceChangeRequest_Old_New_Tariff_Price', ScreenTransition.Fade)
                )
            ),

            // ---- New record ----
            Set(IsEditMode, false);

            Set(
                NextAutoNumber,
                Coalesce(
                    // 2026-11: newest records first, so the app's 2,000-row window holds the highest numbers (also above 2,000 items)
                    Max(Sort('Price Change', ID, SortOrder.Descending), IfError(Value(Mid(Title, 4, Len(Title) - 3)), 0)),
                    0
                ) + 1
            );
            Set(FormattedAutoNumber, "PC-" & Text(NextAutoNumber, "0000000"));

            Set(TPCIDValue, FormattedAutoNumber);
            Set(StatusValue, Dropdown1.Selected.Value);
            Set(PNValue, DataCardValue2.Text);
            Set(DescriptionValue, DataCardValue3.Text);
            Set(VendorCodeValue, DataCardValue4.Text);
            Set(VendorNameValue, DataCardValue5.Text);
            Set(PONumberValue, DataCardValue6.Text);
            Set(RequestorNameValue, User().FullName);
            Set(RequestorEmailValue, User().Email);
            Set(RemarksValue, DataCardValue9.Text);
            Set(RequestorNameAppended, User().FullName);
            Set(ApproverNameValue, If(GroupKeyOwner.Selected.Value = "", "Nil", GroupKeyOwner.Selected.Value));
            Set(CurrencyValue, Dropdown2.Selected.Value);
            Set(ReasonValue, Concat(ComboBoxPriceReason.SelectedItems, Value, ", "));
            Set(ReasonValues, reasonValues);
            Set(StratSourcingPersonnel, TextInput4.Text);
            Set(
                ExchangeRate,
                LookUp('Exchange Rate', Title = Dropdown2.Selected.Value).'USD 2025 (Currency/Rate)'
            );
            Set(StratTeamEmail,
                Concat(Filter(GroupKeyLookup, Title = TextInput4.Text), Email, "; ")
            );
            Set(ApproverEmailValue,
                Concat(Filter(GroupKeyLookup, Title = GroupKeyOwner.Selected.Value), Email, "; ")
            );

            ResetForm(Form1);
            Navigate('PriceChangeRequest_Old_New_Tariff_Price', ScreenTransition.Fade)
        )
    )
);
