-- 2. 找有没有别的对象能把条件记录号对回供应商和物料
SELECT TABLE_SCHEMA, TABLE_NAME, COLUMN_NAME
FROM PowerBI.INFORMATION_SCHEMA.COLUMNS
WHERE COLUMN_NAME LIKE '%VAKEY%'
   OR COLUMN_NAME LIKE '%VAR%KEY%'
   OR TABLE_NAME LIKE '%A017%'
   OR TABLE_NAME LIKE '%A018%'
   OR TABLE_NAME LIKE '%EINE%'
   OR TABLE_NAME LIKE '%INFO%REC%'
ORDER BY TABLE_SCHEMA, TABLE_NAME;
