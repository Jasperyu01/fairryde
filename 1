    // takes the sheet (or table) that holds the header PART_NUMBER, whatever the sheet is called
    HasHeader = (t as table) as logical =>
        List.Contains(Table.ColumnNames(t), "PART_NUMBER")
        or List.AnyTrue(List.Transform(Table.ToRecords(Table.FirstN(t, 20)),
            (r) => List.Contains(Record.ToList(r), "PART_NUMBER"))),
