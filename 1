If(
    IsBlank(DataCardValue24.Text) || IsNumeric(DataCardValue24.Text),
    // Valid scenario: either blank or a number
    
    // 1) Pull down all rows for this PN (delegable)
    Set(
        MatchingRows,
        Filter(
            'Trial',
            PN = Trim(DataCardValue30.Text)
        )
    );
    
    // 2) Apply the non-delegable status check locally
    Set(
        MatchingActiveRows,
        Filter(
            MatchingRows,
            'Status of Completion' in [
                "In Progress",
                "New"
            ]
        )
    );
    
    // 3) Branch on whether we found any active rows
    If(
        !IsEmpty(MatchingActiveRows),
        // --- UPDATE an existing row ---
        Set(
            ActiveRow,
            First(MatchingActiveRows)
        );
        Set(
            ActiveRecord,
            Patch(
                'Trial',
                ActiveRow,
                {
                    'Status of Completion': Dropdown6.Selected.Value,
                    'Estimated Quantity':
                        Value(ActiveRow.'Estimated Quantity')
                        + Value(DataCardValue24.Text),
                    Projects: Concat(
                        SortByColumns(
                            ComboBox2.SelectedItems,
                            "Value",
                            SortOrder.Ascending
                        ),
                        Value,
                        ", "
                    ),
                    Reason:
                        ActiveRow.Reason
                        & ", "
                        & DataCardValue29.Text,
                    'Need Date': Text(
                        Min(
                            DatePicker1.SelectedDate,
                            If(
                                IsBlank(ActiveRow.'Need Date'),
                                DatePicker1.SelectedDate,
                                DateValue(
                                    ActiveRow.'Need Date',
                                    "en-GB"
                                )
                            )
                        ),
                        "[$-en-GB]dd/mmm/yyyy"
                    ),
                    'Requestor Name':
                        ActiveRow.'Requestor Name'
                        & ", "
                        & DataCardValue25.Text,
                    'Requestor Remarks':
                        ActiveRow.'Requestor Remarks'
                        & ", "
                        & DataCardValue32.Text,
                    // Action Owner: keep the current value unless the user changed it
                    'Action Owner': If(
                        DataCardValue27.Text = DataCardValue27.Default,
                        ActiveRow.'Action Owner',
                        DataCardValue27.Text
                    ),
                    'Latest Request Date': Text(
                        Today(),
                        "dd/mmm/yyyy"
                    )
                }
            )
        );
        Set(
            SubmittedRecord,
            ActiveRecord
        );
        Notify(
            "Submitted Successfully!",
            NotificationType.Success
        );
        Navigate(
            'Submitted Record Screen',
            ScreenTransition.Fade
        ),
        
        // --- CREATE a new row ---
        Set(
            NewRecord,
            Patch(
                'Trial',
                Defaults('Trial'),
                {
                    SN: Blank(),
                    PN: DataCardValue30.Text,
                    Description: DataCardValue23.Text,
                    'Status of Completion': "New",
                    'Estimated Quantity': If(
                        IsBlank(DataCardValue24.Text),
                        0,
                        Value(DataCardValue24.Text)
                    ),
                    Projects: Concat(
                        SortByColumns(
                            ComboBox2.SelectedItems,
                            "Value",
                            SortOrder.Ascending
                        ),
                        Value,
                        ", "
                    ),
                    Reason: DataCardValue29.Text,
                    'Creation Date': Text(
                        Today(),
                        "dd/mmm/yyyy"
                    ),
                    'Need Date': Text(
                        DatePicker1.SelectedDate,
                        "dd/mmm/yyyy"
                    ),
                    'Requestor Name': DataCardValue25.Text,
                    'Requestor Remarks': DataCardValue32.Text,
                    'Action Owner': DataCardValue27.Text,
                    'Latest Request Date': Text(
                        Today(),
                        "dd/mmm/yyyy"
                    )
                }
            )
        );
        Set(
            ActiveRecord,
            NewRecord
        );
        If(
            DataCardValue23.DisplayMode = DisplayMode.Edit,
            Patch(
                'Material Master List',
                Defaults('Material Master List'),
                {
                    Title: DataCardValue30.Text,
                    Plant_CD: 2750,
                    Description: DataCardValue23.Text
                }
            )
        );
        Notify(
            "Submitted Successfully!",
            NotificationType.Success
        );
        Navigate(
            'Submitted Record Screen',
            ScreenTransition.Fade
        )
    ),
    
    // Else: if DataCardValue24.Text is not blank and not numeric, show error
    Notify(
        "Please input valid number",
        NotificationType.Error
    )
);
Set(SubmittedRecord, Blank());
