-- 1. 列清单
SELECT TABLE_NAME, COLUMN_NAME, DATA_TYPE
FROM PowerBI.INFORMATION_SCHEMA.COLUMNS
WHERE TABLE_SCHEMA = 'CAR01_CPS_DATA'
  AND TABLE_NAME IN ('v_VENDOR_CONDITION_DATA', 'V_VENDOR_NAMES')
ORDER BY TABLE_NAME, ORDINAL_POSITION;

-- 2. 确认主视图能跑通
SELECT TOP 5 *
FROM [PowerBI].[CAR01_CPS_DATA].[v_VENDOR_CONDITION_DATA] WITH (NOLOCK);

-- 3. 找汇率来源（原视图自带 EXCHNG_RT，这个 schema 里看起来没有）
SELECT TABLE_SCHEMA, TABLE_NAME, COLUMN_NAME
FROM PowerBI.INFORMATION_SCHEMA.COLUMNS
WHERE COLUMN_NAME LIKE '%EXCH%'
   OR TABLE_NAME LIKE '%EXCH%'
   OR TABLE_NAME LIKE '%TCURR%'
ORDER BY TABLE_SCHEMA, TABLE_NAME;
