    SrcSql = "SQL",
    SrcExcel = "Excel",
    SrcDetails = "PPV Details",

    // Text helpers: ToText trims and turns "" into null; ToKey also removes leading zeros
    ToText = (v as any) as nullable text =>
        let
            t = if v = null then null else Text.Trim(Text.From(v, "en-US"))
        in
            if t = null or t = "" then null else t,
    ToKey = (v as any) as nullable text =>
        let
            t = ToText(v),
            z = if t = null then null else Text.TrimStart(t, "0")
        in
