EVALUATE
VAR _open = FILTER ( 'SQL_Qnotes Tasks', 'SQL_Qnotes Tasks'[#Task Status] <> "Completed" )
RETURN
    ROW (
        "Summary card", COUNTROWS ( _open ),
        "MDI table", COUNTROWS ( FILTER ( _open, 'SQL_Qnotes Tasks'[#ECC Superseded by S4] = "N" ) ),
        "Old ECC copies", COUNTROWS ( FILTER ( _open, 'SQL_Qnotes Tasks'[#ECC Superseded by S4] = "Y" ) )
    )
