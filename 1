    XlPart = Table.AddColumn(XlCurrency, "DATA_SOURCE", each SrcExcel, type text),

    // ===== Part 3: PPV_Details (GR / Return lines of finance periods from DetailsStartPeriod) =====
    DetRows = Table.SelectRows(PPV_Details, each
        [Line Type] = "GR / Return" and [GR Date] <> null
        and [Year] <> null and [Month] <> null and [Year] * 100 + [Month] >= DetailsStartPeriod),
    DetSelected = Table.SelectColumns(DetRows, {
        "GR Date", "Year", "Month", "PO", "PO Item", "Material", "Material Description", "Supplier", "Profit Center",
        "Plant", "Last Ref Doc", "Last Mvt Type", "Qty", "Inventory Amt", "Calc Matapp"}),
    DetRenamed = Table.RenameColumns(DetSelected, {
        {"GR Date", "POSTING_DATE"}, {"Year", "POSTING_YEAR"}, {"Month", "POSTING_PERIOD"}, {"PO", "PURCHASE_ORDER"},
        {"Material", "MATERIAL"}, {"Material Description", "ITEM_TEXT"}, {"Supplier", "VENDOR_ACCT_NBR"},
        {"Profit Center", "PROFIT_CENTER"}, {"Plant", "PLANT"}, {"Last Ref Doc", "REF_DOCUMENT_NUM"},
        {"Last Mvt Type", "MOVEMENT_TYPE"}, {"Qty", "QUANTITY"}, {"Inventory Amt", "USD_CURRENCY_VALUE"},
        {"Calc Matapp", "CALC_MATAPP"}}),
    DetItemNumber = Table.AddColumn(DetRenamed, "PURCHASE_ORDER_ITEM", each try Number.From([PO Item], "en-US") otherwise null, type nullable number),
    DetItemKey = Table.AddColumn(DetItemNumber, "PO_Item", each Blank([PURCHASE_ORDER]) & "_" & Blank([PO Item]), type text),
    DetMtrlKey = Table.AddColumn(DetItemKey, "PO_Mtrl", each Blank([PURCHASE_ORDER]) & "_" & Blank([MATERIAL]), type text),
    DetNoItemText = Table.RemoveColumns(DetMtrlKey, {"PO Item"}),
    DetCompany = Table.AddColumn(DetNoItemText, "COMPANY_CODE", each "8093", type text),
    DetPart = Table.AddColumn(DetCompany, "DATA_SOURCE", each SrcDetails, type text),

