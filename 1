    Blank = (v as any) as text => if v = null then "" else Text.From(v, "en-US"),
    // Number and date helpers: the SAP export stores empty cells as "", which a plain type change cannot convert
    ToNumber = (v as any) as nullable number =>
        if v = null then null
        else if v is number then v
