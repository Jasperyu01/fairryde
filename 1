**A. 按列名在整台服务器上找那张底表**

这段整段一起执行。CTE19 自己会出现在结果里，这是正常的，要看的是除它以外的表。

```sql
IF OBJECT_ID('tempdb..#cols') IS NOT NULL DROP TABLE #cols;
CREATE TABLE #cols (DB sysname, TABLE_SCHEMA sysname, TABLE_NAME sysname, COLUMN_NAME sysname);
DECLARE @db sysname, @q nvarchar(max);
DECLARE c CURSOR LOCAL FAST_FORWARD FOR
    SELECT name FROM sys.databases WHERE state_desc = 'ONLINE' AND HAS_DBACCESS(name) = 1;
OPEN c;
FETCH NEXT FROM c INTO @db;
WHILE @@FETCH_STATUS = 0
BEGIN
    SET @q = N'SELECT ' + QUOTENAME(@db, '''') + N', TABLE_SCHEMA, TABLE_NAME, COLUMN_NAME FROM '
           + QUOTENAME(@db) + N'.INFORMATION_SCHEMA.COLUMNS WHERE COLUMN_NAME IN '
           + N'(''FXD_VNDR_IND'', ''SRC_LST_CATG_CD'', ''MTRL_PLN_USE_CD'', ''FXD_PRCH_AGRMNT_IND'', ''FXD_ISU_PLNT_IND'')';
    BEGIN TRY
        INSERT INTO #cols EXEC sp_executesql @q;
    END TRY
    BEGIN CATCH
        PRINT 'skipped ' + @db;
    END CATCH;
    FETCH NEXT FROM c INTO @db;
END;
CLOSE c;
DEALLOCATE c;
SELECT DB, TABLE_SCHEMA, TABLE_NAME, COUNT(*) AS hits
FROM #cols
GROUP BY DB, TABLE_SCHEMA, TABLE_NAME
ORDER BY hits DESC, DB, TABLE_NAME;
```

