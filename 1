let
    // ===== Settings: change the file path on the next line =====
    ExcelPath = "C:\Users\H329097\OneDrive - Halliburton\Desktop\GR History\Receipts_Jul_to_Sep26.XLSX",
    ExcelStart = #date(2026, 7, 1),        // first posting date taken from the Excel
    DetailsStart = #date(2026, 10, 1),     // first posting date NOT taken from the Excel any more
