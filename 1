    //   "Scale Price" is a separate workbook: put // in front of the first line, remove the // from the second line and put in the real path.
    Book = Src,
    // Book = Excel.Workbook(File.Contents("C:\Users\H329097\OneDrive - Halliburton\Desktop\Scale Price.xlsx"), null, true),
    Cols = {"VENDOR_CODE", "VENDOR_NAME", "PART_NUMBER", "PRICING_UNIT", "SCALE_QTY", "UOM", "PRICE_PER_PRICING_UNIT",
        "PRICE_PER_UNIT", "PRICE_PER_PRICING_UNIT_USD", "PRICE_PER_UNIT_USD", "COND_CURRENCY", "EXCHNG_RT", "VALID_TO"},
    // a sheet or table called Scale Price (spaces, underscores and capitals do not matter); a workbook with a single sheet is taken as it is
    Norm = (t) => if t = null then "" else Text.Lower(Text.Remove(Text.From(t), {" ", "_"})),
    Named = Table.SelectRows(Book, each ([Kind] = "Table" or [Kind] = "Sheet") and Norm([Item]) = "scaleprice"),
    Sheets = Table.SelectRows(Book, each [Kind] = "Sheet"),
    Raw = if Table.RowCount(Named) > 0 then Table.Sort(Named, {{"Kind", Order.Descending}}){0}[Data]
        else if Table.RowCount(Sheets) = 1 then Sheets{0}[Data]
        else error "Scale_Price: no sheet or table named Scale Price was found in the workbook",
    // the header row is the first row that holds PART_NUMBER
    WithHeaders = if List.Contains(Table.ColumnNames(Raw), "PART_NUMBER") then Raw
        else Table.PromoteHeaders(
            Table.Skip(Raw, each not List.Contains(Record.ToList(_), "PART_NUMBER")),
            [PromoteAllScalars = true]),
    Kept = Table.SelectColumns(WithHeaders, Cols),
    NoEmptyText = Table.ReplaceValue(Kept, "", null, Replacer.ReplaceValue, Cols),
    NoBlankRows = Table.SelectRows(NoEmptyText, each [PART_NUMBER] <> null),
    Typed = Table.TransformColumnTypes(NoBlankRows, {
        {"VENDOR_CODE",                 type text},
        {"VENDOR_NAME",                 type text},
        {"PART_NUMBER",                 type text},
        {"PRICING_UNIT",                type number},
        {"SCALE_QTY",                   type number},
        {"UOM",                         type text},
        {"PRICE_PER_PRICING_UNIT",      type number},
        {"PRICE_PER_UNIT",              type number},
        {"PRICE_PER_PRICING_UNIT_USD",  type number},
        {"PRICE_PER_UNIT_USD",          type number},
        {"COND_CURRENCY",               type text},
        {"EXCHNG_RT",                   type number},
        {"VALID_TO",                    type datetime}
    }),
    #"Trimmed Vendor" = Table.TransformColumns(Typed, {
        {"VENDOR_CODE", each Text.TrimStart(_, "0"), type text}
    })
in
