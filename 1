            Looked,
            "S26", [US] * IF ( [Q26] < [D26], [Q26], [D26] ),
            "S26A", [US] * IF ( [A26] < [D26], [A26], [D26] ),
            "S26B", [US] * IF ( [B26] < [D26], [B26], [D26] ),
            "S27", [US] * IF ( [Q27] < [D27], [Q27], [D27] ),
            "S27A", [US] * IF ( [A27] < [D27], [A27], [D27] ),
            "S27B", [US] * IF ( [B27] < [D27], [B27], [D27] )
        )
    VAR Ranged =
        ADDCOLUMNS (
            Valued,
            "X26",
                VAR hi = IF ( [S26A] > [S26B], [S26A], [S26B] )
                VAR lo = IF ( [S26A] < [S26B], [S26A], [S26B] )
                RETURN IF ( [S26] > hi, [S26] - hi, IF ( [S26] < lo, [S26] - lo, 0 ) ),
            "X27",
