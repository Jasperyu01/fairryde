    #"Changed Type" = Table.TransformColumnTypes(#"Trimmed Text",{{"ACCT_ENTRY_DATE", type date}, {"ACCT_ENTRY_DATE_TIME", type date}, {"POSTING_DATE", type date}, {"VALUE_DATE", type date}, {"UPDTTM", type date}}),
    #"Duplicated Column" = Table.DuplicateColumn(#"Changed Type", "PURCHASE_ORDER", "PURCHASE_ORDER - Copy"),
