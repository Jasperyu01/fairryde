    Source = Excel.Workbook(File.Contents(FilePath), null, true),
    Raw = Source{[Item="Sheet1",Kind="Sheet"]}[Data],

    Clean = (v) => if v = null then "" else Text.Trim(Text.From(v)),

    // 跳过表头之前的标题行和空行
    Body = Table.Skip(Raw, each not List.Contains(List.Transform(Record.FieldValues(_), Clean), "Material")),
    HeaderRow = List.Transform(Record.FieldValues(Body{0}), Clean),

    // 被截断的列名还原成完整列名
    NameMap = [
        #"Excep Mssg" = "Excep Mssg Key",
        #"Rsch dt wo" = "Rsch dt wo GR",
        #"PO Sch Del" = "PO Sch Del Dt",
        #"Static Rel" = "Static Rel Dt",
        #"PO Open Qt" = "PO Open Qty",
        #"Planned Pr" = "Planned Price x",
        #"PO Itm Txt" = "PO Itm Txt Dt",
        #"Profit cnt" = "Profit cntr",
        #"Min Lot Si" = "Min Lot Size",
        #"Safety Sto" = "Safety Stock",
        #"MM Planed" = "MM Planed Del Time",
        #"Inf Rec Pl" = "Inf Rec Planned Del",
        #"Last Saved" = "Last Saved ID",
        #"PO Create" = "PO Create Date",
        #"Plan Proc" = "Plan Proc Rel Dt",
        #"Strt/Rel D" = "Strt/Rel Dt",
        #"Fix lot Si" = "Fix lot Size",
        #"MRP Contrl" = "MRP Contrlr",
        #"Old Materi" = "Old Material No."
    ],
    NewNames = List.Transform(List.Positions(HeaderRow), (i) =>
        let h = HeaderRow{i} in
            if h = "PROCESSED" then "PROCESSED_h"
            else if h = "" and i > 0 and HeaderRow{i - 1} = "PROCESSED" then "PROCESSED_x"
            else if h = "" then "_blank" & Text.From(i)
            else Record.FieldOrDefault(NameMap, h, h)),
    Renamed = Table.RenameColumns(Table.Skip(Body, 1), List.Zip({Table.ColumnNames(Body), NewNames})),

    // 去掉前后空格，空字符串变 null
    Trimmed = Table.TransformColumns(Renamed, {}, each if _ is text then (if Text.Trim(_) = "" then null else Text.Trim(_)) else _),

    // PROCESSED 的值错位到了右边的无名列，合并回来
    ProcCols = List.Intersect({{"PROCESSED_h", "PROCESSED_x"}, NewNames}),
    Merged = Table.CombineColumns(Trimmed, ProcCols, each List.First(List.RemoveNulls(_)), "PROCESSED"),

    NonBlank = Table.SelectRows(Merged, each [Material] <> null),

    #"Reordered Columns" = Table.SelectColumns(NonBlank, {"Order", "Plant", "MRP Type", "PROCESSED", "Comments", "Mat Status", "MM Pur Grp", "PO Pur Grp", "Vendor", "Name", "Vendor Mat", "Material", "Mat Desc", "MM Planed Del Time", "Plan Proc Rel Dt", "Strt/Rel Dt", "PO Create Date", "MRP El", "Item", "SLn", "Supply Qty", "PO Open Qty", "MAD wo GR", "Rsch dt wo GR", "Excep Mssg Key", "MRP Excep Txt", "PO Sch Del Dt", "Static Rel Dt", "UOM", "STD Price", "Net Price", "Planned Price x", "Price Unit", "Profit cntr", "Min Lot Size", "MRP Contrlr", "Safety Stock", "Inf Rec Planned Del", "PO Type", "Proc Type", "Last Saved ID", "Mat Type", "Old Material No.", "PO Itm Txt Dt", "Fix lot Size"}),

