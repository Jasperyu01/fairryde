        )
    VAR Compared =
        ADDCOLUMNS (
            Expected,
            "Now price", LOOKUPVALUE ( Part_Price[Current Price USD], Part_Price[Part PN], [PN] ),
            "Now source", LOOKUPVALUE ( Part_Price[Price Source], Part_Price[Part PN], [PN] ),
            "Now POs", LOOKUPVALUE ( Part_Price[Last 3 PO Numbers], Part_Price[Part PN], [PN] ),
            "Now qty", LOOKUPVALUE ( Part_Price[Last 3 PO Qty], Part_Price[Part PN], [PN] ),
            "Now newest PO", LOOKUPVALUE ( Part_Price[Last 3 PO Newest Date], Part_Price[Part PN], [PN] ),
            "Ann qty 2027", LOOKUPVALUE ( Part_Price[Ann Qty 2027], Part_Price[Part PN], [PN] )
        )
    VAR Diff =
        FILTER ( Compared, ABS ( [Now price] - [Exp price] ) > 0.005 || [Now POs] <> [Exp POs] )
    VAR Result =
        ADDCOLUMNS ( Diff, "PPV change", [Ann qty 2027] * ( [Exp price] - [Now price] ) )

EVALUATE
    ROW (
        "PNs compared", COUNTROWS ( Compared ),
        "PNs that differ", COUNTROWS ( Result ),
        "PNs with a different price", COUNTROWS ( FILTER ( Result, ABS ( [Now price] - [Exp price] ) > 0.005 ) ),
        "PPV change vs expected", SUMX ( Result, [PPV change] ),
        "PPV now", [Saving Now]
    )

EVALUATE
    SELECTCOLUMNS (
        Result,
        "PN", [PN],
        "PPV change", [PPV change],
        "Now price", [Now price],
        "Exp price", [Exp price],
        "Ann qty 2027", [Ann qty 2027],
        "Now source", [Now source],
        "Exp source", [Exp source],
        "Now POs", [Now POs],
        "Exp POs", [Exp POs],
        "Now qty", [Now qty],
        "Exp qty", [Exp qty],
        "Now newest PO", [Now newest PO]
    )
    ORDER BY [PPV change] DESC
