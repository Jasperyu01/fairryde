    // KE5Z shows a receipt as a negative quantity; the SQL table shows it as positive
    XlSigned = Table.TransformColumns(XlRenamed, {{"QUANTITY", each if _ = null then null else -_, type nullable number}}),
    XlItemKey = Table.AddColumn(XlSigned, "PO_Item", each
        Blank([PURCHASE_ORDER]) & "_" & (if [PURCHASE_ORDER_ITEM] = null then "" else Text.From([PURCHASE_ORDER_ITEM], "en-US")), type text),
    XlMtrlKey = Table.AddColumn(XlItemKey, "PO_Mtrl", each Blank([PURCHASE_ORDER]) & "_" & Blank([MATERIAL]), type text),
    XlCompany = Table.AddColumn(XlMtrlKey, "COMPANY_CODE", each "8093", type text),
