Hi, below is the SQL behind the Incoming PO data in our Power BI report (Server: SCGREPORTING, Database: DUN02_HESDATAMART01). Could you check with the data team whether these source tables are still being refreshed, and when they were last updated? Thanks!

WITH MTRL_MASTER AS (
    SELECT *
    FROM [DUN02_HESDATAMART01].[dbo].[plnt_mtrl] WITH (NOLOCK)
    WHERE PLNT_OID = '1387'
)

SELECT
    A.PO_NBR,
    A.PO_ITM_NBR,
    C.CREAT_DT AS [OPNORDR Creation Date],
    A.ACCT_ASGN_CATG_CD,
    C.PRCH_ORG_CD,
    C.PO_TYPE_CD,
    C.PO_CATG_CD,
    C.PRCH_GRP_CD,
    E.NM AS PO_Buyer_Name,
    MTRL_MASTER.BUYR_CD AS MM_Buyer,
    G.NM AS MM_Buyer_Name,
    MTRL_MASTER.MRP_CNTRLR_CD,
    C.VNDR_NBR AS [OPNORDR Vendor Number],
    V.SRCH_STRNG_1 AS [OPNORDR Vendor Name],
    A.MTRL_NBR AS [OPNORDR Material Number],
    D.MTRL_DSC,
    A.PLNT_CD,
    A.PR_NBR,
    A.PR_ITM_NBR,
    A.PRC_UOM_CD,
    A.UOW_CD,
    A.ICT_1,
    A.ICT_2,
    A.ACCT_ASGN_CATG_CD,
    A.TRGT_QTY,
    A.STRG_LOCN_CD,
    A.BASE_UOM_CD,
    A.MTRL_GRP_CD,
    A.PO_UOM_CD,
    A.PO_QTY,
    A.PO_NET_UNT_PRC,
    A.PRC_UNIT,
    A.NMRTR_PO_PRC,
    A.DNMNTR_PO_PRC,
    A.NMRTR_UNT_CNVRSN,
    A.DNMNTR_UNT_CNVRSN,
    A.PO_VAL,
    C.CRNCY_CD AS PO_CURRENCY,
    A.MTRL_TYPE_CD,
    A.NOTE,
    A.RCPT_FLG,
    A.OUT_AGREE,
    B.SCHED_DLVRY_DT,
    B.PR_ITM_NBR,
    B.MRP_REDUCE_QTY,
    B.COMMIT_DT,
    B.PO_NBR,
    B.PO_ITM_NBR,
    B.DLVRY_SCHED_LN_NBR,
    B.ITM_DLVRY_DT,
    B.SCHED_QTY,
    B.COMMIT_QTY,
    B.STAT_DLVRY_DT,
    B.RCVD_QTY

FROM
    [DUN02_HESDATAMART01].[dbo].[PRCH_ORDR_ITM] A WITH (NOLOCK)
LEFT JOIN
    [DUN02_HESDATAMART01].[dbo].[PO_ITM_SCHED] B WITH (NOLOCK) ON B.PO_ITM_OID = A.OID
LEFT JOIN
    [DUN02_HESDATAMART01].[dbo].[PRCH_ORDR] C WITH (NOLOCK) ON A.PO_NBR = C.PO_NBR
LEFT JOIN
    [DUN02_HESDATAMART01].[dbo].[MTRL] D WITH (NOLOCK) ON A.MTRL_OID = D.OID
LEFT JOIN
    MTRL_MASTER WITH (NOLOCK) ON MTRL_MASTER.MTRL_NBR = D.MTRL_NBR
LEFT
