### 1.2 新建 `SQL_PO_Items`

新版 AllPO。`old_scored`、`old_matched`、`old_ranked` 三段是去重：一张迁移过的 PO，旧号那行和新号那行的物料、vendor、PO 日期、item 号都一样，旧号那行删掉。同一天同一个 vendor 有两张旧 PO 都对得上、只迁移了一张的时候，先按单价和数量挑，还分不出来就挑整张 PO 对得上的 item 更多的那张。没有物料号的 item 不去重（筛 PN 的时候本来就会去掉）。

```powerquery
let
    Source = Sql.Database("SCGREPORTING", "DUN02_HESDATAMART01", [Query = "
WITH base AS (
    SELECT
        po.PO_NBR, poi.PO_ITM_NBR, TRY_CAST(po.PO_DT AS date) AS PO_DT,
        po.VNDR_NBR, v.SRCH_STRNG_1 AS VNDR_NM, po.CRNCY_CD, po.EXCHNG_RT, po.CREAT_BY_NM,
        poi.MTRL_NBR, poi.STRG_LOCN_CD, poi.PO_UOM_CD, poi.BASE_UOM_CD,
        poi.PRC_UNIT, poi.PO_QTY, poi.PO_NET_UNT_PRC, poi.DEL_CD,
        CASE WHEN po.PO_NBR LIKE '454%' THEN 1 ELSE 0 END AS IS_S4,
        CASE WHEN po.PO_NBR LIKE '454%' AND po.CREAT_BY_NM = 'DATA_CNV' THEN 1 ELSE 0 END AS IS_CNV
    FROM dbo.PRCH_ORDR AS po WITH (NOLOCK)
    INNER JOIN dbo.PRCH_ORDR_ITM AS poi WITH (NOLOCK) ON po.OID = poi.PO_OID
    LEFT JOIN dbo.VNDR AS v WITH (NOLOCK) ON v.OID = po.VNDR_OID
    WHERE po.CO_CD = '8093'
      AND poi.STRG_LOCN_CD IN ('S2FA', 'SGP2')
      AND po.PO_CATG_CD = 'F'
      AND (po.PO_NBR LIKE '454%' OR po.PO_DT >= '2025-10-01')
),
old_scored AS (
    SELECT
        o.PO_NBR, o.PO_ITM_NBR, o.MTRL_NBR, o.VNDR_NBR, o.PO_DT,
        COUNT(*) AS N_CNV,
        MIN(CASE
                WHEN c.PO_NET_UNT_PRC = o.PO_NET_UNT_PRC AND c.PO_QTY = o.PO_QTY THEN 0
                WHEN c.PO_NET_UNT_PRC = o.PO_NET_UNT_PRC THEN 1
                WHEN c.PO_QTY = o.PO_QTY THEN 2
                ELSE 3
            END) AS SCORE
    FROM base AS o
    INNER JOIN base AS c
        ON c.IS_CNV = 1
       AND c.MTRL_NBR = o.MTRL_NBR
       AND c.VNDR_NBR = o.VNDR_NBR
       AND c.PO_DT = o.PO_DT
       AND c.PO_ITM_NBR = o.PO_ITM_NBR
    WHERE o.IS_S4 = 0
    GROUP BY o.PO_NBR, o.PO_ITM_NBR, o.MTRL_NBR, o.VNDR_NBR, o.PO_DT
),
old_matched AS (
    SELECT
        s.PO_NBR, s.PO_ITM_NBR, s.MTRL_NBR, s.VNDR_NBR, s.PO_DT, s.N_CNV, s.SCORE,
        SUM(CASE WHEN s.SCORE <= 1 THEN 1 ELSE 0 END) OVER (PARTITION BY s.PO_NBR) AS PO_MATCHES
    FROM old_scored AS s
),
old_ranked AS (
    SELECT
        PO_NBR, PO_ITM_NBR, N_CNV,
        ROW_NUMBER() OVER (
            PARTITION BY MTRL_NBR, VNDR_NBR, PO_DT, PO_ITM_NBR
            ORDER BY SCORE, PO_MATCHES DESC, PO_NBR
        ) AS RN
    FROM old_matched
)
SELECT
    b.PO_NBR, b.PO_ITM_NBR, b.PO_DT, b.VNDR_NBR, b.VNDR_NM, b.CRNCY_CD, b.EXCHNG_RT, b.CREAT_BY_NM,
    b.MTRL_NBR, b.STRG_LOCN_CD, b.PO_UOM_CD, b.BASE_UOM_CD, b.PRC_UNIT, b.PO_QTY, b.PO_NET_UNT_PRC, b.DEL_CD,
    b.IS_S4, b.IS_CNV
FROM base AS b
LEFT JOIN old_ranked AS t
    ON t.PO_NBR = b.PO_NBR
   AND t.PO_ITM_NBR = b.PO_ITM_NBR
   AND t.RN <= t.N_CNV
WHERE t.PO_NBR IS NULL
"]),
    Typed = Table.TransformColumnTypes(Source, {
            {"PO_NBR", Int64.Type}, {"PO_ITM_NBR", Int64.Type}, {"PO_DT", type date},
            {"VNDR_NBR", type text}, {"VNDR_NM", type text}, {"CRNCY_CD", type text},
            {"EXCHNG_RT", type number}, {"CREAT_BY_NM", type text}, {"MTRL_NBR", type text},
            {"STRG_LOCN_CD", type text}, {"PO_UOM_CD", type text}, {"BASE_UOM_CD", type text},
            {"PRC_UNIT", type number}, {"PO_QTY", type number}, {"PO_NET_UNT_PRC", type number},
            {"DEL_CD", type text}, {"IS_S4", Int64.Type}, {"IS_CNV", Int64.Type}
        }),
    Trimmed = Table.TransformColumns(Typed, {
            {"CRNCY_CD", Text.Trim, type text}, {"STRG_LOCN_CD", Text.Trim, type text},
            {"PO_UOM_CD", Text.Trim, type text}, {"BASE_UOM_CD", Text.Trim, type text},
            {"VNDR_NM", Text.Trim, type text}
        }),
    Deduped = Table.Distinct(Trimmed, {"PO_NBR", "PO_ITM_NBR"})
in
    Deduped
```

