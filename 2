### 1.4 新建 `PO_Items`

```powerquery
let
    AddPN = Table.AddColumn(SQL_PO_Items, "Part PN",
        each try Int64.From(Text.TrimStart(Text.Trim([MTRL_NBR]), "0")) otherwise null, Int64.Type),
    Joined = Table.NestedJoin(AddPN, {"Part PN"}, PN_List, {"Part PN"}, "pn", JoinKind.Inner),
    OnlyPNs = Table.RemoveColumns(Joined, {"pn"}),
    AddVendor = Table.AddColumn(OnlyPNs, "Vendor Number",
        each if [VNDR_NBR] = null then null else Text.TrimStart(Text.Trim([VNDR_NBR]), "0"), type text),
    AddLabel = Table.AddColumn(AddVendor, "Vendor Label",
        each if [VNDR_NM] = null or [VNDR_NM] = "" then [#"Vendor Number"] else [VNDR_NM], type text),
    FX = Settings{0}[#"FX USD per SGD"],
    // USD per unit: USD as is; other currencies x SGD rate on the PO x FX (same as PPX). JPY prices are stored / 100 in the datamart.
    AddUSD = Table.AddColumn(AddLabel, "USD Unit Price",
        each if [PO_NET_UNT_PRC] = null then null
            else
                let
                    p = [PO_NET_UNT_PRC] * (if [CRNCY_CD] = "JPY" then 100 else 1)
                        / (if [PRC_UNIT] = null or [PRC_UNIT] <= 0 then 1 else [PRC_UNIT])
                in
                    if [CRNCY_CD] = "USD" then p else p * (if [EXCHNG_RT] = null then 0 else [EXCHNG_RT]) * FX,
        type number),
    Out = Table.Buffer(AddUSD)
in
    Out
```

### 1.5 替换 `Open_PO`

```powerquery
let
    AddPN = Table.AddColumn(SQL_Open_PO, "Part PN",
        each try Int64.From(Text.TrimStart(Text.Trim([MTRL_NBR]), "0")) otherwise null, Int64.Type),
    Joined = Table.NestedJoin(AddPN, {"Part PN"}, PN_List, {"Part PN"}, "pn", JoinKind.Inner),
    OnlyPNs = Table.RemoveColumns(Joined, {"pn"}),
    AddKey = Table.AddColumn(OnlyPNs, "Schedule Key",
        each Text.From([PO_NBR]) & "_" & Text.From([PO_ITM_NBR]) & "_" & Text.From([DLVRY_SCHED_LN_NBR]), type text),
    Deduped = Table.Distinct(AddKey, {"Schedule Key"}),
    FX = Settings{0}[#"FX USD per SGD"],
    From2027 = Settings{0}[#"PO Price From"],
    AddVendor = Table.AddColumn(Deduped, "Vendor Number",
        each if [VNDR_NBR] = null then null else Text.TrimStart(Text.Trim([VNDR_NBR]), "0"), type text),
    // price per price unit in the PO currency (JPY prices are stored / 100 in the datamart)
    AddPrice = Table.AddColumn(AddVendor, "Unit Price PO Crcy",
        each if [PO_NET_UNT_PRC] = null then null else [PO_NET_UNT_PRC] * (if [CRNCY_CD] = "JPY" then 100 else 1), type number),
    // USD per unit of PO currency: SGD at the Settings FX, other currencies at the SGD rate on the PO x FX (same as PO_Lines)
    AddRate = Table.AddColumn(AddPrice, "Exchange Rate",
        each if [CRNCY_CD] = "USD" then 1
            else if [CRNCY_CD] = "SGD" then FX
            else (if [EXCHNG_RT] = null then 0 else [EXCHNG_RT]) * FX, type number),
    AddFactor = Table.AddColumn(AddRate, "Rate Factor", each 1, type number),
    AddOpen = Table.AddColumn(AddFactor, "Open Qty",
        each (if [SCHED_QTY] = null then 0 else [SCHED_QTY]) - (if [RCVD_QTY] = null then 0 else [RCVD_QTY]), type number),
    Renamed = Table.RenameColumns(AddOpen, {
            {"PO_NBR", "PO Number"}, {"PO_ITM_NBR", "PO Item"}, {"DLVRY_SCHED_LN_NBR", "Schedule Line"},
            {"PO_DT", "PO Created"}, {"VNDR_NM", "Vendor Name"}, {"MTRL_DSC", "Material Description"},
            {"PO_TYPE_CD", "PO Type"}, {"PRCH_GRP_CD", "Purch Group (PO)"}, {"CRNCY_CD", "PO Currency"},
            {"PRC_UNIT", "Price Unit"}, {"PO_UOM_CD", "PO UoM"}, {"BASE_UOM_CD", "Base UoM"},
            {"ITM_DLVRY_DT", "Delivery Date"}, {"STRG_LOCN_CD", "Storage Location"}, {"PO_QTY", "PO Qty"}
        }),
    AddUSD = Table.AddColumn(Renamed, "USD Unit Price",
        each [#"Unit Price PO Crcy"]
            / (if [#"Price Unit"] = null or [#"Price Unit"] = 0 then 1 else [#"Price Unit"])
            * [#"Exchange Rate"],
