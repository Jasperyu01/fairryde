Screens:
  PriceChangeRequest_ScalePrices:
    Properties:
      Fill: =RGBA(234, 234, 234, 1)
      LoadingSpinnerColor: =RGBA(164, 38, 44, 1)
      OnVisible: |-
        =// ======== 2026-11: Scale Prices page ========
        // colScaleRows holds the scale lines typed on this page (Scale Quantity + New Price), drpScaleCurrency their currency.
        // The rows belong to one request: when another request is opened (other PN / vendor / TPCID / new vs edit), the rows are
        // cleared and the currency is set again, so nothing can be carried over from an abandoned request.
        With(
            { _key: If(IsEditMode, "E", "N") & "|" & TPCIDValue & "|" & PNValue & "|" & VendorCodeValue },
            If(
                IsBlank(varScaleKey) || varScaleKey <> _key,
                Set(varScaleKey, _key);
                Clear(colScaleRows);
                With(
                    {
                        // Edit of an open request: the scale lines saved earlier, "1: USD 12.50, 100: USD 12.55, ..."
                        _parts: Filter(
                            Split(If(IsEditMode, Coalesce(ActiveRowP.ScalePrices, ""), ""), ","),
                            !IsBlank(Trim(Value))
                        )
                    },
                    With(
                        {
                            // currency of the saved lines (text between ":" and the price of the first line)
                            _savedCur: If(
                                IsEmpty(_parts),
                                "",
                                IfError(
                                    With(
                                        { _r: Trim(Last(Split(First(_parts).Value, ":")).Value) },
                                        Left(_r, Find(" ", _r) - 1)
                                    ),
                                    ""
                                )
                            )
                        },
                        // Currency shown in the dropdown: saved one (edit), else the currency of the request, else USD
                        Set(
                            varScaleCurrency,
                            If(
                                !IsBlank(_savedCur) && (_savedCur in ["USD", "SGD", "GBP", "CAD", "EUR", "MYR", "JPY"]),
                                _savedCur,
                                CurrencyValue in ["USD", "SGD", "GBP", "CAD", "EUR", "MYR", "JPY"],
                                CurrencyValue,
                                "USD"
                            )
                        )
                    );
                    Collect(
                        colScaleRows,
                        ForAll(
                            _parts As _t,
                            With(
                                {
                                    _qty: Trim(First(Split(_t.Value, ":")).Value),
                                    _rest: Trim(Last(Split(_t.Value, ":")).Value)
                                },
                                With(
                                    {
                                        _q: IfError(Value(_qty, "en-US"), Blank()),
                                        _p: IfError(Value(Trim(Mid(_rest, Find(" ", _rest) + 1)), "en-US"), Blank())
                                    },
                                    {
                                        RowID: Text(GUID()),
                                        Qty: If(IsBlank(_q), _qty, _q = Int(_q), Text(_q, "[$-en-US]0"), Text(_q, "[$-en-US]0.###")),
                                        NewP: If(IsBlank(_p), "", Text(_p, "[$-en-US]0.00###"))
                                    }
                                )
                            )
                        )
                    )
                );
                // start with one empty row, so it is clear where to type
                If(IsEmpty(colScaleRows), Collect(colScaleRows, { RowID: Text(GUID()), Qty: "", NewP: "" }));
                Reset(drpScaleCurrency)
            )
        )
    Children:
      - recScaleHeader:
          Control: Rectangle@2.3.0
          Properties:
            BorderColor: =RGBA(89, 0, 0, 1)
            Fill: =RGBA(164, 38, 44, 1)
            Height: =100
            Width: =1366
      - lblScaleHeader:
          Control: Label@2.5.1
          Properties:
            BorderColor: =RGBA(89, 0, 0, 1)
            Color: =RGBA(255, 255, 255, 1)
            Font: =Font.'Open Sans'
            FontWeight: =FontWeight.Semibold
            Height: =100
            Size: =24
            Text: ="Price Change Request"
            Width: =900
            X: =40
      - lblScaleTitle:
          Control: Label@2.5.1
          Properties:
            Align: =Align.Center
            BorderColor: =RGBA(89, 0, 0, 1)
            Color: =RGBA(151, 0, 0, 1)
            Font: =Font.'Open Sans'
            FontWeight: =FontWeight.Semibold
            Height: =50
            Size: =22
            Text: ="Scale Prices"
            Width: =1366
            Y: =112
      - lblScaleHelp:
          Control: Label@2.5.1
          Properties:
            Align: =Align.Center
            BorderColor: =RGBA(89, 0, 0, 1)
            Font: =Font.'Open Sans'
            Height: =56
            Size: =12
            Text: |-
              ="Enter all scale prices of the quotation: one row for each Scale Quantity. The price line of the previous page can be entered again." & Char(10) & "At least one row is required. If the quotation has only one price, enter that price."
            Width: =1166
            X: =100
            Y: =162
      - lblScaleBase:
          Control: Label@2.5.1
          Properties:
            Align: =Align.Center
            BorderColor: =RGBA(89, 0, 0, 1)
            Fill: =RGBA(255, 255, 255, 1)
            Font: =Font.'Open Sans'
            FontWeight: =FontWeight.Semibold
            Height: =44
            Size: =12
            Text: |-
              ="Previous page:    Scale Quantity " & Text(ScaleQuantityValue) & "    |    Old Price " & CurrencyValue & " " & OldPriceValue & "    |    New Price " & CurrencyValue & " " & NewPriceValue
            Width: =800
            X: =283
            Y: =226
      - lblScaleCurrency:
          Control: Label@2.5.1
          Properties:
            BorderColor: =RGBA(89, 0, 0, 1)
            Font: =Font.'Open Sans'
            Height: =38
            Text: ="Currency of the scale prices"
            Width: =215
            X: =417
            Y: =286
      - drpScaleCurrency:
          Control: Classic/DropDown@2.3.1
          Properties:
            BorderColor: =RGBA(89, 0, 0, 1)
            ChevronBackground: =RGBA(164, 38, 44, 1)
            ChevronFill: =RGBA(255, 255, 255, 1)
            ChevronHoverBackground: =ColorFade(RGBA(164, 38, 44, 1), -20%)
            ChevronHoverFill: =RGBA(255, 255, 255, 1)
            Default: =varScaleCurrency
            Font: =Font.'Open Sans'
            Height: =38
            HoverFill: =RGBA(222, 179, 184, 1)
            Items: =["USD", "SGD", "GBP", "CAD", "EUR", "MYR", "JPY"]
            Items.Value: =Value
            PressedColor: =RGBA(255, 255, 255, 1)
            PressedFill: =RGBA(89, 0, 0, 1)
            SelectionColor: =RGBA(255, 255, 255, 1)
            SelectionFill: =RGBA(164, 38, 44, 1)
            Width: =200
            X: =637
            Y: =286
      - lblScaleColQty:
          Control: Label@2.5.1
          Properties:
            BorderColor: =RGBA(89, 0, 0, 1)
            Font: =Font.'Open Sans'
            Height: =36
            Text: ="Scale Quantity"
            Width: =200
            X: =417
            Y: =336
      - lblScaleColNew:
          Control: Label@2.5.1
          Properties:
            BorderColor: =RGBA(89, 0, 0, 1)
            Font: =Font.'Open Sans'
            Height: =36
            Text: |-
              ="New Price (" & drpScaleCurrency.Selected.Value & ")"
            Width: =230
            X: =637
            Y: =336
      - galScaleRows:
          Control: Gallery@2.15.0
          Variant: BrowseLayout_Vertical_TwoTextOneImageVariant_ver5.0
          Properties:
            BorderColor: =RGBA(89, 0, 0, 1)
            Height: =286
            Items: =colScaleRows
            TemplateSize: =56
            Width: =566
            X: =400
            Y: =372
          Children:
            - txtScaleQty:
                Control: Classic/TextInput@2.3.2
                Properties:
                  BorderColor: =RGBA(89, 0, 0, 1)
                  Default: =ThisItem.Qty
                  Font: =Font.'Open Sans'
                  Height: =40
                  HoverBorderColor: =RGBA(89, 0, 0, 1)
                  HoverFill: =RGBA(222, 179, 184, 1)
                  OnChange: |-
                    =Patch(colScaleRows, ThisItem, { Qty: Trim(txtScaleQty.Text) })
                  Width: =200
                  X: =17
                  Y: =8
            - txtScaleNew:
                Control: Classic/TextInput@2.3.2
                Properties:
                  BorderColor: =RGBA(89, 0, 0, 1)
                  Default: =ThisItem.NewP
                  Font: =Font.'Open Sans'
                  Height: =40
                  HoverBorderColor: =RGBA(89, 0, 0, 1)
                  HoverFill: =RGBA(222, 179, 184, 1)
                  OnChange: |-
                    =Patch(colScaleRows, ThisItem, { NewP: Trim(txtScaleNew.Text) })
                  Width: =200
                  X: =237
                  Y: =8
            - btnScaleDelete:
                Control: Classic/Button@2.2.0
                Properties:
                  BorderColor: =ColorFade(Self.Fill, -15%)
                  Color: =RGBA(255, 255, 255, 1)
                  DisabledBorderColor: =RGBA(166, 166, 166, 1)
                  Fill: =RGBA(64, 106, 151, 1)
                  Font: =Font.'Open Sans'
                  Height: =40
                  HoverBorderColor: =ColorFade(Self.BorderColor, 20%)
                  HoverColor: =RGBA(255, 255, 255, 1)
                  HoverFill: =ColorFade(RGBA(164, 38, 44, 1), -20%)
                  OnSelect: =Remove(colScaleRows, ThisItem)
                  PressedBorderColor: =Self.Fill
                  PressedColor: =Self.Fill
                  PressedFill: =Self.Color
                  Text: ="Delete"
                  Width: =80
                  X: =457
                  Y: =8
      - btnScaleAdd:
          Control: Classic/Button@2.2.0
          Properties:
            BorderColor: =ColorFade(Self.Fill, -15%)
            Color: =RGBA(255, 255, 255, 1)
            DisabledBorderColor: =RGBA(166, 166, 166, 1)
            Fill: =RGBA(0, 128, 0, 1)
            Font: =Font.'Open Sans'
            HoverBorderColor: =ColorFade(Self.BorderColor, 20%)
            HoverColor: =RGBA(255, 255, 255, 1)
            HoverFill: =ColorFade(RGBA(164, 38, 44, 1), -20%)
            OnSelect: |-
              =Collect(colScaleRows, { RowID: Text(GUID()), Qty: "", NewP: "" })
            PressedBorderColor: =Self.Fill
            PressedColor: =Self.Fill
            PressedFill: =Self.Color
            Text: ="Add scale row"
            Width: =200
            X: =417
            Y: =668
      - btnScaleBack:
          Control: Classic/Button@2.2.0
          Properties:
            BorderColor: =ColorFade(Self.Fill, -15%)
            Color: =RGBA(255, 255, 255, 1)
            DisabledBorderColor: =RGBA(166, 166, 166, 1)
            Fill: =RGBA(164, 38, 44, 1)
            Font: =Font.'Open Sans'
            FontWeight: =FontWeight.Bold
            HoverBorderColor: =ColorFade(Self.BorderColor, 20%)
            HoverColor: =RGBA(255, 255, 255, 1)
            HoverFill: =ColorFade(RGBA(164, 38, 44, 1), -20%)
            OnSelect: =Navigate(PriceChangeRequest_Old_New_Tariff_Price, ScreenTransition.Fade)
            PressedBorderColor: =Self.Fill
            PressedColor: =Self.Fill
            PressedFill: =Self.Color
            Text: ="Back"
            Y: =728
      - btnScaleProceed:
          Control: Classic/Button@2.2.0
          Properties:
            BorderColor: =ColorFade(Self.Fill, -15%)
            Color: =RGBA(255, 255, 255, 1)
            DisabledBorderColor: =RGBA(166, 166, 166, 1)
            Fill: =RGBA(164, 38, 44, 1)
            Font: =Font.'Open Sans'
            HoverBorderColor: =ColorFade(Self.BorderColor, 20%)
            HoverColor: =RGBA(255, 255, 255, 1)
            HoverFill: =ColorFade(RGBA(164, 38, 44, 1), -20%)
            OnSelect: |-
              =// ======== 2026-11: Scale Prices page, Proceed ========
              // The page is mandatory: at least one scale line is needed. The lines may start again from the smallest scale quantity
              // of the previous page. Checks the lines, then builds colScaleFinal (sorted by quantity) for the Submit button, which
              // turns it into the single SharePoint text (ScalePrices) and into the email table.
              With(
                  {
                      // rows the user filled in; completely empty rows are ignored
                      _rows: Filter(colScaleRows, !(IsBlank(Trim(Qty)) && IsBlank(Trim(NewP)))),
                      _baseQty: Value(ScaleQuantityValue),
                      _baseNew: IfError(Value(NewPriceValue), Blank()),
                      _cur: drpScaleCurrency.Selected.Value
                  },
                  If(
                      IsEmpty(_rows),
                      Notify(
                          "Scale prices are required: please enter at least one row with a Scale Quantity and a New Price. If the quotation has only one price, enter that price.",
                          NotificationType.Error
                      ),

                      !IsEmpty(
                          Filter(
                              _rows,
                              !IsNumeric(Trim(Qty)) || Value(Trim(Qty)) <= 0 ||
                              !IsNumeric(Trim(NewP)) || Value(Trim(NewP)) <= 0
                          )
                      ),
                      Notify(
                          "Every scale row needs a Scale Quantity and a New Price, both numbers greater than 0. Please correct or delete the incomplete row(s).",
                          NotificationType.Error
                      ),

                      CountRows(Distinct(_rows, Value(Trim(Qty)))) < CountRows(_rows),
                      Notify("The same Scale Quantity is entered more than once. Please keep one row per Scale Quantity.", NotificationType.Error),

                      !IsEmpty(Filter(_rows, Value(Trim(Qty)) < _baseQty)),
                      Notify(
                          "A Scale Quantity on this page is smaller than " & Text(_baseQty) & ", the smallest scale quantity entered on the previous page. Please correct this page, or go Back and correct the previous page.",
                          NotificationType.Error
                      ),

                      // Same currency as the request: the line for the smallest scale must agree with the previous page
                      // (0.0051 allows for the rounding to 2 decimals on the previous page).
                      _cur = CurrencyValue && !IsBlank(_baseNew) &&
                      !IsEmpty(Filter(_rows, Value(Trim(Qty)) = _baseQty && Abs(Value(Trim(NewP)) - _baseNew) > 0.0051)),
                      Notify(
                          "Scale Quantity " & Text(_baseQty) & " has New Price " & CurrencyValue & " " & NewPriceValue & " on the previous page, but a different New Price on this page. Please make the two prices the same.",
                          NotificationType.Error
                      ),

                      // ---- all rows are valid ----
                      Clear(colScaleFinal);
                      // Same currency and the smallest scale was not typed again: its line from the previous page is added,
                      // so the saved text always starts with the smallest scale.
                      If(
                          _cur = CurrencyValue && IsEmpty(Filter(_rows, Value(Trim(Qty)) = _baseQty)),
                          Collect(colScaleFinal, { Qty: _baseQty, NewText: NewPriceValue, NewNum: _baseNew })
                      );
                      Collect(
                          colScaleFinal,
                          ForAll(
                              Sort(_rows, Value(Trim(Qty))),
                              {
                                  Qty: Value(Trim(Qty)),
                                  NewText: Text(Value(Trim(NewP)), "[$-en-US]#,##0.00###"),
                                  NewNum: Value(Trim(NewP))
                              }
                          )
                      );
                      Set(ScaleCurrencyValue, _cur);
                      // The Submit button only uses colScaleFinal when this key still matches the request and its first price line
                      Set(
                          varScaleFinalKey,
                          If(IsEditMode, "E", "N") & "|" & TPCIDValue & "|" & PNValue & "|" & VendorCodeValue & "|" &
                          ScaleQuantityValue & "|" & OldPriceValue & "|" & NewPriceValue
                      );
                      Navigate('PriceChangeRequest_Email Submission', ScreenTransition.Fade)
                  )
              )
            PressedBorderColor: =Self.Fill
            PressedColor: =Self.Fill
            PressedFill: =Self.Color
            Text: ="Proceed"
            X: =1206
            Y: =728
