    CountFA = Settings{0}[#"Count FA POs"],
    From2027 = Settings{0}[#"PO Price From"],
    Sum0 = (l as list) as number => let s = List.Sum(l) in if s = null then 0 else s,

    // ---- open FA: S2FA items still open (one row per PO item)
    OpenItems = Table.Distinct(
        Table.SelectColumns(Open_PO, {"PO Number", "PO Item", "Part PN", "Vendor Number", "Storage Location"}),
        {"PO Number", "PO Item"}),
    FAItems = Table.SelectRows(OpenItems, each [#"Storage Location"] = "S2FA"),
    FAKeys = Table.Distinct(Table.SelectColumns(FAItems, {"Part PN", "Vendor Number"})),
    FACount = Table.Group(FAItems, {"Part PN"}, {{"Open FA Items", each Table.RowCount(_), Int64.Type}}),

    // ---- last 3 PO: every PO of a vendor with an open FA item for the PN is left out
    WithFA = Table.NestedJoin(PO_Items, {"Part PN", "Vendor Number"}, FAKeys, {"Part PN", "Vendor Number"}, "fa", JoinKind.LeftOuter),
    Flagged = Table.AddColumn(WithFA, "Open FA Vendor", each if Table.RowCount([fa]) > 0 then 1 else 0, Int64.Type),
    Items = Table.RemoveColumns(Flagged, {"fa"}),
    LeftOut = Table.Group(Table.SelectRows(Items, each [#"Open FA Vendor"] = 1), {"Part PN"},
        {{"PO Items Left Out (Open FA)", each Table.RowCount(_), Int64.Type}}),
    Valid = Table.SelectRows(Items, each
        [#"Open FA Vendor"] = 0
        and [PO_UOM_CD] = [BASE_UOM_CD]
        and [#"USD Unit Price"] <> null and [#"USD Unit Price"] > 0
        and [PO_QTY] <> null and [PO_QTY] > 0
        and (CountIC <> "N" or not Text.StartsWith(if [#"Vendor Number"] = null then "" else [#"Vendor Number"], "P"))),
    AddValue = Table.AddColumn(Valid, "Value USD", each [#"USD Unit Price"] * [PO_QTY], type number),
    POs = Table.Group(AddValue, {"Part PN", "PO_NBR"}, {
            {"PO Date", each List.Max([PO_DT]), type date},
            {"Qty", each List.Sum([PO_QTY]), type number},
            {"Value", each List.Sum([#"Value USD"]), type number},
            {"Vendor", each List.First([#"Vendor Label"]), type text}
        }),
    // newest PO date first; same date: higher PO number first
    ByPN = Table.Group(POs, {"Part PN"}, {
            {"Top", (t) => Table.FirstN(Table.Sort(t, {{"PO Date", Order.Descending}, {"PO_NBR", Order.Descending}}), 3), type table}
        }),
    L3 = Table.AddColumn(ByPN, "r", each
        let
            t = [Top],
            n = Table.RowCount(t),
            q = Sum0(t[Qty]),
            v = Sum0(t[Value])
        in
            [
                #"Last 3 PO Count" = n,
                #"Last 3 PO Qty" = q,
                #"Last 3 PO Wtd Price USD" = if q > 0 then v / q else null,
                #"Last 3 PO Avg Price USD" = List.Average(List.Transform(Table.ToRecords(t), (x) => x[Value] / x[Qty])),
                #"Last 3 PO Newest Date" = t[#"PO Date"]{0},
                #"Last 3 PO Oldest Date" = t[#"PO Date"]{n - 1},
                #"Last 3 PO Numbers" = Text.Combine(List.Transform(t[PO_NBR], each Text.From(_)), ", "),
                #"Last 3 PO Vendors" = Text.Combine(List.Transform(t[Vendor], each if _ = null then "" else _), ", ")
            ]),
    L3Out = Table.ExpandRecordColumn(Table.RemoveColumns(L3, {"Top"}), "r", {"Last 3 PO Count", "Last 3 PO Qty", "Last 3 PO Wtd Price USD", "Last 3 PO Avg Price USD", "Last 3 PO Newest Date", "Last 3 PO Oldest Date", "Last 3 PO Numbers", "Last 3 PO Vendors"}),

    // ---- open PO figures per PN (reference columns; used when Current price basis = PO or Drusilla)
    FARows = Table.SelectRows(FA_Tracker, each [#"Confirmed FA"] <> "N" and [#"FA PO Number"] <> null),
    FAList = List.Buffer(List.Transform(Table.ToRecords(FARows),
        (x) => x[#"FA PO Number"] & "|" & (if x[#"FA PO Item"] = null then "" else x[#"FA PO Item"]))),
    OL = Table.AddColumn(Open_PO, "FA Cand",
        each if List.Contains(FAList, Text.From([#"PO Number"]) & "|" & Text.From([#"PO Item"])) then 1 else 0, Int64.Type),
    OpenAgg = Table.Group(OL, {"Part PN"}, {{"o", (t) =>
        let
            val = (x as table) as number =>
                Sum0(List.Transform(Table.ToRecords(x),
                    (y) => (if y[#"USD Unit Price"] = null then 0 else y[#"USD Unit Price"]) * y[#"Open Qty"])),
            priced = Table.SelectRows(t, each [#"Priced Line"] = "Y"),
            pq = Sum0(priced[#"Open Qty"]),
            fq = Sum0(Table.SelectRows(priced, each [#"FA Cand"] = 1)[#"Open Qty"]),
            counted = if CountFA = "N" then Table.SelectRows(priced, each [#"FA Cand"] = 0) else priced,
            c27 = Table.SelectRows(counted, each [#"Delivery Date"] <> null and [#"Delivery Date"] >= From2027),
            q27 = Sum0(c27[#"Open Qty"]),
            qa = Sum0(counted[#"Open Qty"]),
            p27 = if q27 > 0 then val(c27) / q27 else if qa > 0 then val(counted) / qa else null,
            latest = List.Max(t[#"PO Created"]),
            cl = Table.SelectRows(counted, each [#"PO Created"] = latest),
            ql = Sum0(cl[#"Open Qty"])
        in
            [
                #"SQL Open PO Lines" = Table.RowCount(t),
                #"SQL Open PO Qty" = Sum0(t[#"Open Qty"]),
                #"FA Share of Open PO Qty" = if pq = 0 then 0 else fq / pq,
                #"PO Price 2027 USD" = p27,
                #"PO Price Basis" = if p27 = null then null else if q27 > 0 then "2027 deliveries" else "All open lines",
                #"Latest PO Date" = latest,
                #"Latest PO Price USD" = if ql > 0 then val(cl) / ql else null
            ], type record}}),
    OpenOut = Table.ExpandRecordColumn(OpenAgg, "o", {"SQL Open PO Lines", "SQL Open PO Qty", "FA Share of Open PO Qty", "PO Price 2027 USD", "PO Price Basis", "Latest PO Date", "Latest PO Price USD"}),

    // ---- one row per PN
    J1 = Table.NestedJoin(PN_List, {"Part PN"}, L3Out, {"Part PN"}, "a", JoinKind.LeftOuter),
    E1 = Table.ExpandTableColumn(J1, "a", {"Last 3 PO Count", "Last 3 PO Qty", "Last 3 PO Wtd Price USD", "Last 3 PO Avg Price USD", "Last 3 PO Newest Date", "Last 3 PO Oldest Date", "Last 3 PO Numbers", "Last 3 PO Vendors"}),
    J2 = Table.NestedJoin(E1, {"Part PN"}, OpenOut, {"Part PN"}, "b", JoinKind.LeftOuter),
    E2 = Table.ExpandTableColumn(J2, "b", {"SQL Open PO Lines", "SQL Open PO Qty", "FA Share of Open PO Qty", "PO Price 2027 USD", "PO Price Basis", "Latest PO Date", "Latest PO Price USD"}),
    J3 = Table.NestedJoin(E2, {"Part PN"}, FACount, {"Part PN"}, "c", JoinKind.LeftOuter),
    E3 = Table.ExpandTableColumn(J3, "c", {"Open FA Items"}),
    J4 = Table.NestedJoin(E3, {"Part PN"}, LeftOut, {"Part PN"}, "d", JoinKind.LeftOuter),
    E4 = Table.ExpandTableColumn(J4, "d", {"PO Items Left Out (Open FA)"}),
    Zeros = Table.ReplaceValue(E4, null, 0, Replacer.ReplaceValue,
        {"Last 3 PO Count", "Last 3 PO Qty", "SQL Open PO Lines", "SQL Open PO Qty", "FA Share of Open PO Qty", "Open FA Items", "PO Items Left Out (Open FA)"}),
    Typed = Table.TransformColumnTypes(Zeros, {
            {"Last 3 PO Count", Int64.Type}, {"Last 3 PO Qty", type number},
            {"Last 3 PO Wtd Price USD", type number}, {"Last 3 PO Avg Price USD", type number},
            {"Last 3 PO Newest Date", type date}, {"Last 3 PO Oldest Date", type date},
            {"Last 3 PO Numbers", type text}, {"Last 3 PO Vendors", type text},
            {"SQL Open PO Lines", Int64.Type}, {"SQL Open PO Qty", type number},
            {"FA Share of Open PO Qty", type number}, {"PO Price 2027 USD", type number},
            {"PO Price Basis", type text}, {"Latest PO Date", type date}, {"Latest PO Price USD", type number},
