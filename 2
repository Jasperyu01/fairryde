## 第 2 部分：PO_Lines 不再重复算迁移过的 PO

交货数量（Delivery Qty）的规则改成：**S/4 里还开着的 PO 行算计划数量（SCHED_QTY），其他的只算已收货数量（RCVD_QTY）**。旧号 PO 在 cutover 以后不会再收货，没收的那部分已经在新号上，所以旧号只算收到的。没收完就关闭或删除的行，以前按整行的计划数量算，现在也只算收到的。

依据：iCruise PN 上能和 21 Sep 那版 Open PO 对上的迁移过的 item 有 1,914 个，其中 1,868 个（98%）新 PO 的数量正好等于旧 PO 当时的未收数量，33 个更少（这期间又收了货），13 个更多。也就是新号带的是剩余数量，不是整张 PO。

### 2.1 替换 `PO_Lines`

Home > Transform data，左边点 **PO_Lines**，Advanced Editor，全删，粘贴，Done（SQL 变了，会再弹一次 Native Database Query，点 Run），Close & Apply。和原来比：SQL 里多取 SCHED_QTY、RCVD_QTY，DLVRY_QTY 改成上面的规则；JPY 的单价乘回 100；表里多了 `Sched Qty`、`Rcvd Qty` 两列用来核对。FROM 和 WHERE 没动，行数不变。

```powerquery
let
    Source = Sql.Database("SCGREPORTING", "DUN02_HESDATAMART01", [Query = "
SELECT
    po.PO_NBR, poi.PO_ITM_NBR, sl.DLVRY_SCHED_LN_NBR AS SCHED_LN_NBR, po.PO_DT,
    TRY_CAST(sl.ITM_DLVRY_DT AS DATE) AS DLVRY_DT,
    TRY_CAST(sl.SCHED_DLVRY_DT AS DATE) AS SCHED_DT,
    sl.SCHED_QTY AS SCHED_QTY,
    ISNULL(sl.RCVD_QTY, 0) AS RCVD_QTY,
    CASE
        WHEN po.PO_NBR LIKE '454%'
             AND poi.DEL_CD IS NULL
             AND ISNULL(poi.DLVRY_CMPLT_FLG, 0) = 0
             AND sl.SCHED_QTY > ISNULL(sl.RCVD_QTY, 0)
        THEN sl.SCHED_QTY
        ELSE ISNULL(sl.RCVD_QTY, 0)
    END AS DLVRY_QTY,
    po.VNDR_NBR, po.CRNCY_CD, po.EXCHNG_RT, po.PRCH_GRP_CD,
    poi.MTRL_NBR, poi.STRG_LOCN_CD, poi.PO_UOM_CD, poi.BASE_UOM_CD, poi.PRC_UNIT, poi.PO_NET_UNT_PRC
FROM dbo.PRCH_ORDR AS po WITH (NOLOCK)
INNER JOIN dbo.PRCH_ORDR_ITM AS poi WITH (NOLOCK) ON po.OID = poi.PO_OID
INNER JOIN dbo.PO_ITM_SCHED AS sl WITH (NOLOCK) ON sl.PO_ITM_OID = poi.OID
WHERE po.CO_CD = '8093'
  AND poi.STRG_LOCN_CD IN ('S2FA', 'SGP2')
  AND po.PO_CATG_CD = 'F'
  AND ISNULL(po.DEL_FLG, 0) = 0
  AND sl.ITM_DLVRY_DT >= '2026-01-01'
  AND sl.ITM_DLVRY_DT < '2028-01-01'
"]),
    Typed = Table.TransformColumnTypes(Source, {
            {"PO_NBR", Int64.Type}, {"PO_ITM_NBR", Int64.Type}, {"SCHED_LN_NBR", Int64.Type},
            {"PO_DT", type date}, {"DLVRY_DT", type date}, {"SCHED_DT", type date}, {"SCHED_QTY", type number}, {"RCVD_QTY", type number}, {"DLVRY_QTY", type number},
            {"VNDR_NBR", type text}, {"CRNCY_CD", type text}, {"EXCHNG_RT", type number},
            {"PRCH_GRP_CD", type text}, {"MTRL_NBR", type text}, {"STRG_LOCN_CD", type text},
            {"PO_UOM_CD", type text}, {"BASE_UOM_CD", type text}, {"PRC_UNIT", type number},
            {"PO_NET_UNT_PRC", type number}
        }),
    Trimmed = Table.TransformColumns(Typed, {
            {"CRNCY_CD", Text.Trim, type text}, {"STRG_LOCN_CD", Text.Trim, type text},
            {"PO_UOM_CD", Text.Trim, type text}, {"BASE_UOM_CD", Text.Trim, type text}
        }),
    Deduped = Table.Distinct(Trimmed, {"PO_NBR", "PO_ITM_NBR", "SCHED_LN_NBR"}),
    AddPN = Table.AddColumn(Deduped, "Part PN",
        each try Int64.From(Text.TrimStart(Text.Trim([MTRL_NBR]), "0")) otherwise null, Int64.Type),
    AddVendor = Table.AddColumn(AddPN, "Vendor Number",
        each if [VNDR_NBR] = null then null else Text.TrimStart(Text.Trim([VNDR_NBR]), "0"), type text),
    // JPY prices are stored / 100 in the datamart
    AddUnit = Table.AddColumn(AddVendor, "Unit Price PO Crcy",
        each [PO_NET_UNT_PRC] * (if [CRNCY_CD] = "JPY" then 100 else 1)
            / (if [PRC_UNIT] = null or [PRC_UNIT] = 0 then 1 else [PRC_UNIT]), type number),
    AddPriced = Table.AddColumn(AddUnit, "Priced Line",
        each if [PO_UOM_CD] <> null and [PO_UOM_CD] = [BASE_UOM_CD] then "Y" else "N", type text),
    AddFA = Table.AddColumn(AddPriced, "FA PO",
        each if [STRG_LOCN_CD] = "S2FA" then "Y" else "N", type text),
    AddMonth = Table.AddColumn(AddFA, "Delivery Month",
        each if [DLVRY_DT] = null then null else Date.StartOfMonth([DLVRY_DT]), type date),
    Renamed = Table.RenameColumns(AddMonth, {
            {"PO_NBR", "PO Number"}, {"PO_ITM_NBR", "PO Item"}, {"SCHED_LN_NBR", "Schedule Line"},
            {"PO_DT", "PO Date"}, {"DLVRY_DT", "Delivery Date"}, {"SCHED_DT", "Sched Delivery Date"},
            {"DLVRY_QTY", "Delivery Qty"}, {"SCHED_QTY", "Sched Qty"}, {"RCVD_QTY", "Rcvd Qty"}, {"CRNCY_CD", "PO Currency"}, {"EXCHNG_RT", "SGD per PO Currency"},
            {"PRCH_GRP_CD", "Purch Group (PO)"}, {"STRG_LOCN_CD", "Storage Location"}
        }),
    Kept = Table.SelectColumns(Renamed, {
            "PO Number", "PO Item", "Schedule Line", "Part PN", "Vendor Number", "PO Date",
            "Delivery Date", "Sched Delivery Date", "Delivery Month", "Delivery Qty", "PO Currency",
            "SGD per PO Currency", "Unit Price PO Crcy", "Priced Line", "FA PO", "Storage Location",
            "Purch Group (PO)", "Sched Qty", "Rcvd Qty"
        })
in
    Kept
```

