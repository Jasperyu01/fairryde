// ============================================================
// PCR Mass Approval - Approve button OnSelect
// Every parsed row is saved in 'Price Change' as "Approved by Strategic Sourcing".
// No approval flow runs and no email is sent. The Status column of the template is ignored.
//
// STEP 0 checks every row first. If any row has a problem, NOTHING is written:
//   - Annual Quantity is blank or 0
//   - the same PN + Vendor Code + Scale Qty appears twice in this upload
// STEP 1 writes each row with ONE Patch (all fields + status together), so a row is either
//   fully saved as Approved or not saved at all.
//   Same PN + Vendor as an open request (Pending Approval / Feedback or blank status, the same
//   rule as Mass Upload): that record is updated and approved, no new record is created.
//   Otherwise a new record with a new TPCID is created.
// STEP 2 reports the TPCIDs; rows that failed to save stay in the list for a retry.
// ============================================================

With(
    {
        _approvedStatus: "Approved by Strategic Sourcing"   // must match exactly what the approval flow writes
    },
    If(
        varDisableWrite,
        Notify(
            "Cannot approve: fix the rows reported by Parse Data, then press Parse Data again.",
            NotificationType.Error
        ),
        CountRows(colTempData) = 0,
        Notify(
            "No parsed rows found. Paste + Parse first.",
            NotificationType.Error
        ),
        CountRows(colTempData) > 100,
        Notify(
            "Please upload max 100 rows per cycle.",
            NotificationType.Error
        ),

        // ===== STEP 0: CHECK EVERY ROW, WRITE NOTHING IF ANY ROW FAILS =====
        ClearCollect(
            colApprCheck,
            ForAll(
                colTempData As r,
                {
                    RowPN: r.PNVar,
                    Problem: If(
                        Coalesce(r.AnnualQuantityVar, 0) <= 0,
                        "Annual Quantity is blank or 0",
                        CountRows(
                            Filter(
                                colTempData,
                                PNVar = r.PNVar && VendorCodeVar = r.VendorCodeVar && ScaleQuantityVar = r.ScaleQuantityVar
                            )
                        ) > 1,
                        "same PN + Vendor + Scale Qty twice in this upload",
                        ""
                    )
                }
            )
        );

        If(
            CountRows(Filter(colApprCheck, Problem <> "")) > 0,
            Notify(
                "Cannot approve, nothing saved -> " &
                Concat(
                    FirstN(Filter(colApprCheck, Problem <> ""), 5),
                    RowPN & " [" & Problem & "]",
                    "  |  "
                ),
                NotificationType.Error
            ),

            // ===== STEP 1: SAVE EVERY ROW AS APPROVED (one Patch per row) =====
            ClearCollect(
                colApprResults,
                ForAll(
                    colTempData,
                    With(
                        {
                            // open request for the same PN + Vendor (same rule as Mass Upload, written so SharePoint can delegate it)
                            existingSP: LookUp(
                                'Price Change',
                                PN = PNVar && 'Vendor Code' = VendorCodeVar &&
                                ('Request Status' = "Pending Approval / Feedback" || 'Request Status' = Blank())
                            )
                        },
                        With(
                            {
                                // ONE Patch per row: every column + the Approved status together.
                                // Open request found -> that record is updated (it keeps its TPCID); otherwise a new record
                                // with a new TPCID is created.
                                // (2026-11 fix) The record is written directly inside Patch. Built beforehand in a With
                                // variable, Power Apps does not map display names such as Approver or 'Request Status'
                                // to the SharePoint columns, and Patch failed ("column 'Approver' does not exist").
                                written: IfError(
                                    Patch(
                                        'Price Change',
                                        If(IsBlank(existingSP), Defaults('Price Change'), existingSP),
                                        {
                                            Title: If(
                                                IsBlank(existingSP),
                                                "PC-" & Text(
                                                    Coalesce(
                                                        // 2026-11: newest records first, so the app's 2,000-row window holds the highest numbers (also above 2,000 items)
                                                        Max(
                                                            Sort('Price Change', ID, SortOrder.Descending),
                                                            IfError(Value(Mid(Title, 4, Len(Title) - 3)), 0)
                                                        ),
                                                        0
                                                    ) + 1,
                                                    "0000000"
                                                ),
                                                existingSP.Title
                                            ),
                                            Date: Today(),
                                            PN: PNVar,
                                            Description: DescriptionVar,
                                            'Vendor Code': VendorCodeVar,
                                            'Vendor Name': VendorNameVar,
                                            'PO Number': PONumberVar,
                                            'Requestor Name': RequestorVar,
                                            Remarks: RemarksVar,
                                            Currency: CurrencyVar,
                                            'Request Status': _approvedStatus,
                                            'Strategic Sourcing Personnel': Trim(Substitute(StrategicVar, Char(160), " ")),
                                            Approver: Trim(Substitute(CMGroupKeyVar, Char(160), " ")),
                                            'Price Change Reason - Tariff': ReasonTariff,
                                            'Price Change Reason - Labour Cost Inflation': ReasonLabour,
                                            'Price Change Reason - Raw Material Inflation': ReasonRawMaterial,
                                            'Price Change Reason - ECTS': ReasonECTS,
                                            'Price Change Reason - Price Decrease': ReasonPriceDecrease,
                                            'Price Change Reason - Add More Scale Qty': ReasonAddQty,
                                            'Price Change Reason - Others': ReasonOthers,
                                            'Old Price in Stated Currency': OldPriceVar,
                                            'Old Price in USD': OldPriceUSDVar,
                                            'New Price in Stated Currency': NewPriceVar,
                                            'New Price in USD': NewPriceUSDVar,
                                            'Price Delta': PriceDeltaVar,
                                            'Scale Quantity': ScaleQuantityVar,
                                            'Tariff Percentage': TariffPercentageVar,
                                            'Tariff Value (USD)': TariffValueUSDVar,
                                            'Estimated Tariff Annual Impact (USD)': EstimatedAnnualTariffImpactVar,
                                            'Estimated Delta Annual Impact (USD)': AnnualPriceDeltaImpactVar,
                                            AnnualQuantity: Coalesce(If(AnnualQuantityVar = Int(AnnualQuantityVar), Text(AnnualQuantityVar, "[$-en-US]#,##0"), Text(AnnualQuantityVar, "[$-en-US]#,##0.##")), "N/A"),
                                            'Email Link': EmailLinkVar
                                            // TODO: add here the other columns the approval flow sets when Strategic Sourcing
                                            // approves (for example approver, approval date, comments, action owner,
                                            // latest sourcing update), so these rows look the same in Power BI.
                                        }
                                    ),
                                    Blank()
                                )
                            },
                            {
                                rPN: PNVar,
                                rVendorCode: VendorCodeVar,
                                rScaleQty: ScaleQuantityVar,
                                rTPCID: If(IsBlank(written), "", written.Title),
                                rWasOpen: !IsBlank(existingSP),
                                rOK: !IsBlank(written)
                            }
                        )
                    )
                )
            );

            // ===== STEP 2: REPORT, KEEP ONLY THE FAILED ROWS FOR A RETRY =====
            With(
                {
                    okRows: Filter(colApprResults, rOK),
                    badRows: Filter(colApprResults, !rOK)
                },
                If(
                    CountRows(badRows) = 0,
                    Notify(
                        "Approved " & Text(CountRows(okRows)) & " row(s)" &
                        If(
                            CountRows(Filter(okRows, rWasOpen)) > 0,
                            " (" & Text(CountRows(Filter(okRows, rWasOpen))) & " were open requests)",
                            ""
                        ) &
                        ": " & Concat(FirstN(okRows, 10), rTPCID, ", ") & If(CountRows(okRows) > 10, ", ...", ""),
                        NotificationType.Success
                    ),
                    Notify(
                        "Approved " & Text(CountRows(okRows)) & " of " & Text(CountRows(colApprResults)) &
                        " row(s). Not saved, press Approve again to retry: " &
                        Concat(FirstN(badRows, 10), rPN, ", "),
                        NotificationType.Error
                    )
                )
            );

            // saved rows leave the list, so a second Approve cannot save them twice
            RemoveIf(
                colTempData,
                !IsBlank(
                    LookUp(
                        colApprResults,
                        rOK && rPN = PNVar && rVendorCode = VendorCodeVar && rScaleQty = ScaleQuantityVar
                    )
                )
            );

            Refresh('Price Change')
        )
    )
)
